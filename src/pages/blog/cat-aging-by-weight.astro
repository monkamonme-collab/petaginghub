---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatWeightGuide from '../../components/CatWeightGuide.astro';
const title = '熟齡貓體重變化：體態、肌肉狀態與日常觀察';
const description = '了解熟齡貓的體重趨勢、體態與肌肉狀態，以及何時與獸醫討論變化。體重不能換算生理年齡或壽命。';
const siteUrl = 'https://www.petaginghub.com';
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/blog/cat-aging-by-weight' },
  { lang: 'x-default', url: siteUrl + '/blog/cat-aging-by-weight' },
];
const breadcrumbs = [{ label: '部落格', url: '/blog/' }, { label: '貓咪體重變化', url: '/blog/cat-aging-by-weight/' }];
---
<BaseLayout title={title} description={description} lang="zh-TW" breadcrumbs={breadcrumbs} hrefLangAlternates={hrefLangAlternates}>
  <CatWeightGuide lang="zh-TW" />
</BaseLayout>
