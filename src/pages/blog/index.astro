  },
  {
    url: "/blog/senior-cat-care/",
    title: "老年貓咪照護完整指南：11歲後的健康管理",
    description: "貓咪進入高齡期後常見的健康問題與照護重點，幫助你的老貓維持良好生活品質。",
    image: "https://images.unsplash.com/photo-1536590158209-e9d615d525e4?w=800"
  },
  {
    url: "/blog/pet-joint-health/",
    title: "寵物關節健康保養指南：預防與緩解老年關節炎",
    description: "關節炎是老年寵物最常見的問題之一。了解關節保健補充品、適當運動與環境改善，讓毛孩活動更自在。",
    image: "https://images.unsplash.com/photo-1560743641-3914f2c45636?w=800"
  },
  {
    url: "/blog/when-to-see-vet/",
    title: "什麼時候該帶寵物看獸醫？10個不容忽視的警示訊號",
    description: "寵物無法開口說不舒服，學會辨識這10個緊急警示訊號，在關鍵時刻為毛孩爭取最佳治療時機。",
    image: "https://images.unsplash.com/photo-1628009368231-7bb7cfcb0def?w=800"
  }
];

const categories = [
  { name: '寵物健康', slug: 'health', icon: '💊' },
  { name: '寵物營養', slug: 'nutrition', icon: '🍖' },
  { name: '寵物照護', slug: 'care', icon: '🛁' },
];

const siteUrl = "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/blog/' },
  { lang: 'en', url: siteUrl + '/en/blog/' },
  { lang: 'x-default', url: siteUrl + '/blog/' },
];
---

<BaseLayout
  title="部落格 | 寵物知識與教育性指南"
  description="老年寵物照護的教育資訊，作為與獸醫討論的參考。涵蓋狗狗與貓咪的老化徵兆、營養建議與健康照護指南。"
  lang="zh-TW"
  hrefLangAlternates={hrefLangAlternates}>
<main class="max-w-5xl mx-auto px-6 py-12">
  <header class="text-center mb-16">
    <h1 class="text-4xl font-extrabold text-slate-900 mb-4">寵物健康部落格</h1>
    <p class="text-lg text-slate-600 max-w-2xl mx-auto">老年寵物照護的教育資訊，作為與獸醫討論的參考</p>
  </header>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
    {displayPosts.map((post) => (
      <a href={post.url} class="group">
        <Card class="h-full overflow-hidden border border-slate-100 hover:shadow-xl transition-all p-0">
          <div class="aspect-video bg-slate-100 overflow-hidden">
            <img
              src={post.image}
              alt={post.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-5">
            <h3 class="font-bold text-slate-900 group-hover:text-amber-600 transition-colors line-clamp-2">
              {post.title}
            </h3>
            <p class="text-sm text-slate-500 mt-2 line-clamp-2">{post.description}</p>
          </div>
        </Card>
      </a>
    ))}
  </div>

  <section class="bg-slate-50 rounded-3xl p-10 border border-slate-200">
    <h2 class="text-2xl font-bold text-slate-900 mb-8 text-center">按分類探索</h2>
    <div class="grid md:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <a href={`/blog/category/${cat.slug}/`} class="block bg-white rounded-2xl p-6 border border-slate-200 text-center hover:border-amber-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-amber-600">
          <div class="text-4xl mb-4">{cat.icon}</div>
          <h3 class="text-lg font-bold text-slate-900">{cat.name}</h3>
        </a>
      ))}
    </div>
  </section>
</main>
</BaseLayout>
