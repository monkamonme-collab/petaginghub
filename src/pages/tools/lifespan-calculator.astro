---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';
import { dogSizeBands, getDogSizeLabel, lifespanRanges } from '../../utils/agingModel';

const currentPath = Astro.url.pathname;

const siteUrl = Astro.site?.origin ?? "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/tools/lifespan-calculator' },
  { lang: 'x-default', url: siteUrl + '/tools/lifespan-calculator' },
];
---

<BaseLayout
  title="寵物壽命範圍參考工具：犬貓教育性估算"
  description="輸入寵物的年齡、體型與生活背景，查看壽命範圍與生命階段的教育性參考；這不是壽命保證或醫療預測。"
  breadcrumbs={[{ label: '工具集', url: '/tools' }, { label: '寵物壽命計算機', url: currentPath }]}
 lang="zh-TW" hrefLangAlternates={hrefLangAlternates}>
  <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border-b border-emerald-100">
    <div class="max-w-5xl mx-auto px-6 py-12 text-center">
      <div class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1.5 rounded-full mb-4">
        🧮 進階工具
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-4 leading-tight">
        寵物壽命計算機
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        根據體型、年齡和生活背景，提供壽命範圍與生命階段的教育性參考；個體差異可能很大。
      </p>
    </div>
  </div>

  <!-- Calculator Section -->
  <div class="max-w-5xl mx-auto px-6 py-12">
    <!-- Input Form -->
    <div class="max-w-2xl mx-auto bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden mb-12">
      <div class="bg-gradient-to-r from-emerald-500 to-teal-500 p-6 text-white">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <span>📊</span> 輸入你家寵物的資料
        </h2>
      </div>
      <div class="p-8 space-y-6">
        <!-- Pet Type -->
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-3">你的寵物是？</label>
          <div class="grid grid-cols-2 gap-4" role="group" aria-label="選擇寵物種類">
            <button
              type="button"
              id="type-dog"
              class="pet-type-btn flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-slate-200 hover:border-emerald-300 transition-all"
              data-type="dog"
              aria-pressed="false"
            >
              <span class="text-4xl">🐕</span>
              <span class="font-semibold text-slate-700">狗狗</span>
            </button>
            <button
              type="button"
              id="type-cat"
              class="pet-type-btn flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-slate-200 hover:border-emerald-300 transition-all"
              data-type="cat"
              aria-pressed="false"
            >
              <span class="text-4xl">🐱</span>
              <span class="font-semibold text-slate-700">貓咪</span>
            </button>
          </div>
        </div>

        <!-- Dog Breed -->
        <div id="dog-breed-section" class="hidden">
          <label for="dog-breed" class="block text-sm font-semibold text-slate-700 mb-2">狗狗體型（影響範圍參考）</label>
          <select
            id="dog-breed"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
          >
            <option value="">選擇成年體型</option>
            {dogSizeBands.map(({ size }) => <option value={size}>{getDogSizeLabel(size, 'zh')}；本站壽命參考 {lifespanRanges.dog[size].join('–')} 歲</option>)}
            <optgroup label="混種">
              <option value="mixed">米克斯（依成年體重估算）</option>
            </optgroup>
          </select>
          <p id="mixed-weight-hint" class="hidden text-xs text-slate-500 mt-2">
            💡 請在下方填入狗狗的成年體重（如果不知道，可以估計）。
          </p>
        </div>

        <!-- Cat Weight -->
        <div id="cat-weight-section" class="hidden">
          <label for="cat-type" class="block text-sm font-semibold text-slate-700 mb-2">貓咪生活／品種背景（影響範圍參考）</label>
          <select
            id="cat-type"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
          >
            <option value="">選擇生活／品種背景</option>
            <option value="indoor">室內貓</option>
            <option value="outdoor">戶外／自由活動貓</option>
            <option value="indoor_outdoor">室內外活動貓</option>
            <option value="large_breed">大型品種（例如緬因、布偶）</option>
          </select>
          <p class="text-sm text-slate-600 mt-2">這些分類與範圍是本站教育性假設，不是官方統計或個別壽命預測；生活環境與品種類別也可能重疊。想看人類年齡對照，請用<a href="/tools/cat-age-calculator/" class="text-blue-700 underline">貓咪年齡計算機</a>。</p>
        </div>

        <!-- Age -->
        <div>
          <label for="pet-age" class="block text-sm font-semibold text-slate-700 mb-2">寵物目前年齡（歲）</label>
          <input
            type="number"
            id="pet-age"
            min="0"
            max="30"
            value="5"
            step="any"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
          />
        </div>

        <!-- Weight for mixed dogs -->
        <div id="mixed-weight-section" class="hidden">
          <label for="mixed-weight" class="block text-sm font-semibold text-slate-700 mb-2">狗狗體重（kg）</label>
          <input
            type="number"
            id="mixed-weight"
            min="1"
            max="80"
            step="any"
            value="15"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200"
          />
        </div>

        <!-- Optional health-history context: notes only, never alters the numeric range. -->
        <fieldset class="space-y-3">
          <legend class="text-sm font-semibold text-slate-700 mb-2">照護與健康背景（選填）</legend>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="spayed" class="w-4 h-4 text-emerald-600 rounded" />
            <span class="text-sm text-slate-700">已結紮</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="regular-vet" class="w-4 h-4 text-emerald-600 rounded" />
            <span class="text-sm text-slate-700">定期接受獸醫檢查</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="overweight" class="w-4 h-4 text-emerald-600 rounded" />
            <span class="text-sm text-slate-700">目前有過重或肥胖疑慮</span>
          </label>
          <p class="text-xs text-slate-600">以上選項僅用於提供與獸醫討論的背景提示，不會改變本站壽命參考範圍，也不能推算個別剩餘年數。</p>
        </fieldset>

        <button
          id="calculate-btn"
          class="w-full py-4 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-bold text-lg rounded-xl transition-all shadow-lg hover:shadow-xl"
        >
          查看壽命範圍參考 →
        </button>
      </div>
    </div>

    <p id="lifespan-error" role="alert" class="text-red-700 font-medium" hidden></p>
    <!-- Results Section (hidden initially) -->
    <div id="results-section" aria-live="polite" aria-atomic="true" class="hidden">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-2">壽命範圍參考</h2>
        <p class="text-slate-500">以下為本站教育性參考範圍，並非個別寵物的統計預測</p>
      </div>

      <!-- Main Result Card -->
      <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-3xl p-8 text-white mb-8 text-center">
        <p class="text-sm opacity-80 mb-2">範圍中點減目前年齡（不是剩餘壽命預測）</p>
        <p class="text-6xl md:text-7xl font-extrabold mb-2" id="remaining-years">--</p>
        <p class="text-2xl mb-4">年</p>
        <p class="text-emerald-100" id="life-expectancy"></p>
      </div>

      <!-- Detailed Stats -->
      <div class="grid md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 border border-slate-200 text-center">
          <p class="text-sm text-slate-500 mb-1">人類年齡對照</p>
          <p class="text-4xl font-bold text-slate-900" id="human-age">--</p>
          <p class="text-slate-600">歲</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-slate-200 text-center">
          <p class="text-sm text-slate-500 mb-1">生命階段</p>
          <p class="text-4xl font-bold text-slate-900" id="life-stage">--</p>
          <p class="text-slate-600" id="life-stage-sub"></p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-slate-200 text-center">
          <p class="text-sm text-slate-500 mb-1">本站壽命參考範圍</p>
          <p class="text-4xl font-bold text-slate-900" id="total-age">--</p>
          <p class="text-slate-600">歲</p>
        </div>
      </div>

      <!-- Life Progress Bar -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 mb-8">
        <h3 id="range-progress-heading" class="font-bold text-slate-900 mb-4">年齡相對於本站參考中點</h3>
        <div class="relative">
          <div class="h-4 bg-slate-100 rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-gradient-to-r from-emerald-400 to-teal-500 transition-all duration-1000" style="width: 0%"></div>
          </div>
          <div class="flex justify-between text-xs text-slate-500 mt-2">
            <span>出生</span>
            <span id="current-age-marker">0歲</span>
            <span id="range-end-label">參考中點（非壽命終點）</span>
          </div>
        </div>
      </div>

      <!-- Health Recommendations -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 mb-8">
        <h3 class="font-bold text-slate-900 mb-4">📋 照護建議</h3>
        <div id="health-recommendations" class="space-y-3">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Calculator CTA -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-100 text-center">
        <p class="text-slate-700 font-medium mb-4">想查看你家寵物的一般年齡對照嗎？</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/tools/dog-age-calculator/"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-3 rounded-xl transition-colors"
          >
            🐕 狗狗年齡計算機
          </a>
          <a
            href="/tools/cat-age-calculator/"
            class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-3 rounded-xl transition-colors"
          >
            🐱 貓咪年齡計算機
          </a>
        </div>
      </div>
    </div>
  </div>

  <AdSenseAd format="in-article" />

  <!-- Info Section -->
  <div class="max-w-4xl mx-auto px-6 py-12 border-t border-slate-200">
    <h2 class="text-2xl font-bold text-slate-900 mb-6">關於壽命計算機</h2>
    <div class="prose-slate max-w-none">
      <p class="text-slate-700 leading-relaxed mb-4">
        本工具使用依物種、犬隻體型或貓咪生活／品種背景整理的教育性範圍。這些範圍不能預測個別寵物的壽命、健康或醫療需求。
      </p>
      <p class="text-slate-700 leading-relaxed mb-4">
        需要注意的是：<strong>這些數值僅為一般參考</strong>。遺傳、病史、環境、體態與照護都可能造成很大的個體差異；如需個別評估，請諮詢獸醫。
      </p>
    </div>

    <div class="mt-8 grid md:grid-cols-3 gap-4">
      <a href="/blog/dog-aging-by-breed/" class="group bg-white rounded-2xl p-5 border border-slate-200 hover:border-emerald-300 hover:shadow-lg transition-all">
        <h3 class="font-bold text-slate-900 mb-2 group-hover:text-emerald-700">🐕 狗狗品種與老化</h3>
        <p class="text-sm text-slate-600">了解各品種的老化時間表和健康建議</p>
      </a>
      <a href="/blog/cat-aging-by-weight/" class="group bg-white rounded-2xl p-5 border border-slate-200 hover:border-teal-300 hover:shadow-lg transition-all">
        <h3 class="font-bold text-slate-900 mb-2 group-hover:text-teal-700">🐱 貓咪體重與老化</h3>
        <p class="text-sm text-slate-600">觀察貓咪體態、體重趨勢與肌肉狀態，不用體重推算老年歲數</p>
      </a>
      <a href="/blog/dog-vs-cat-aging/" class="group bg-white rounded-2xl p-5 border border-slate-200 hover:border-amber-300 hover:shadow-lg transition-all">
        <h3 class="font-bold text-slate-900 mb-2 group-hover:text-amber-700">📊 狗與貓老化比較</h3>
        <p class="text-sm text-slate-600">兩種寵物的老化速度和壽命差異分析</p>
      </a>
    </div>
  </div>

  <script>
    import { estimateDogHumanAge, estimateCatHumanAge, estimateLifespanRange, getDogLifeStage, getCatLifeStage, getDogSizeByWeight } from '../../utils/agingModel';
    let petType = '';
    let dogBreed = '';
    let catType = '';
    let mixedWeight = 15;
    let petAge = 5;
    let spayed = false;

    // Human age conversion
    function getDogModelSize() {
      if (dogBreed === 'mixed') return getDogSizeByWeight(mixedWeight) || 'medium';
      return dogBreed || 'medium';
    }
    function dogToHuman(years) { return estimateDogHumanAge(years, getDogModelSize() as 'small' | 'medium' | 'large' | 'giant'); }
    function catToHuman(years) { return estimateCatHumanAge(years); }

    function getLifeStage(years, isDog = true, breed = 'medium') {
      const stage = isDog
        ? getDogLifeStage(years, breed as 'small' | 'medium' | 'large' | 'giant')
        : getCatLifeStage(years);
      const labels = {
        puppy: { stage: '幼年期', sub: '一般生命階段參考' }, adult: { stage: '成年期', sub: '一般生命階段參考' },
        senior: { stage: '老年期', sub: '一般生命階段參考' },
        kitten: { stage: '幼貓期', sub: '一般生命階段參考' }, youngAdult: { stage: '青年成貓期', sub: '一般生命階段參考' }, matureAdult: { stage: '成熟成貓期', sub: '一般生命階段參考' }
      };
      return labels[stage];
    }

    let categoryErrorControl: HTMLElement | null = null;

    function clearCategoryError() {
      if (!categoryErrorControl) return;
      categoryErrorControl.removeAttribute('aria-invalid');
      categoryErrorControl.removeAttribute('aria-describedby');
      categoryErrorControl = null;
      const error = document.getElementById('lifespan-error')!;
      error.hidden = true;
      error.textContent = '';
    }

    function calculate() {
      clearCategoryError();
      const ageInput = document.getElementById('pet-age') as HTMLInputElement;
      const weightInput = document.getElementById('mixed-weight') as HTMLInputElement;
      const ageValid = ageInput.value !== '' && !ageInput.validity.badInput && Number.isFinite(ageInput.valueAsNumber) && ageInput.valueAsNumber >= 0 && ageInput.valueAsNumber <= 30;
      const weightNeeded = petType === 'dog' && dogBreed === 'mixed';
      const weightValid = !weightNeeded || (weightInput.value !== '' && Number.isFinite(weightInput.valueAsNumber) && weightInput.valueAsNumber >= 1 && weightInput.valueAsNumber <= 80);
      const categoryValid = (petType === 'dog' && dogBreed !== '') || (petType === 'cat' && catType !== '');
      ageInput.setAttribute('aria-describedby', 'lifespan-error');
      weightInput.setAttribute('aria-describedby', 'lifespan-error');
      ageInput.setAttribute('aria-invalid', String(!ageValid));
      weightInput.setAttribute('aria-invalid', String(!weightValid));
      const error = document.getElementById('lifespan-error')!;
      error.hidden = ageValid && weightValid && categoryValid;
      if (!error.hidden) {
        error.textContent = !ageValid ? '請輸入 0 到 30 歲的有效年齡，可以使用小數。' : !weightValid ? '請輸入 1 到 80 kg 的有效成年體重。' : '請選擇寵物種類及對應的體型或生活背景。';
        document.getElementById('results-section')!.classList.add('hidden');
        if (!ageValid) ageInput.focus();
        else if (!weightValid) weightInput.focus();
        else {
          categoryErrorControl = document.getElementById(petType === 'dog' ? 'dog-breed' : petType === 'cat' ? 'cat-type' : 'type-dog')!;
          categoryErrorControl.setAttribute('aria-invalid', 'true');
          categoryErrorControl.setAttribute('aria-describedby', 'lifespan-error');
          categoryErrorControl.focus();
        }
        return;
      }
      error.textContent = '';
      petAge = ageInput.valueAsNumber;
      if (weightNeeded) mixedWeight = weightInput.valueAsNumber;
      const dogCategory = dogBreed ? getDogModelSize() : '';
      const category = petType === 'dog' ? dogCategory : catType;
      if ((petType !== 'dog' && petType !== 'cat') || !category) return;
      const [low, high] = estimateLifespanRange(petType, category as 'small' | 'medium' | 'large' | 'giant' | 'indoor' | 'outdoor' | 'indoor_outdoor' | 'large_breed');
      const adjusted = (low + high) / 2;

      // Calculate remaining and total
      const remaining = Math.max(0, adjusted - petAge);
      const totalAge = adjusted;

      // Human age
      const humanAge = petType === 'dog' ? dogToHuman(petAge) : catToHuman(petAge);

      // Life stage
      const breed = petType === 'dog' ? getDogModelSize() : 'standard';
      const lifeStage = getLifeStage(petAge, petType === 'dog', breed);

      // Progress
      const progress = Math.min(100, (petAge / totalAge) * 100);

      // Update DOM
      document.getElementById('remaining-years').textContent = remaining.toFixed(1);
      document.getElementById('human-age').textContent = humanAge;
      document.getElementById('life-stage').textContent = lifeStage.stage;
      document.getElementById('life-stage-sub').textContent = lifeStage.sub;
      document.getElementById('range-progress-heading').textContent = '年齡相對於本站參考中點（不是生命進度）';
      document.getElementById('range-end-label').textContent = '參考中點，不是壽命終點';
      document.getElementById('total-age').textContent = `${low}–${high}`;
      document.getElementById('life-expectancy').textContent = `生命階段：${lifeStage.stage}（${lifeStage.sub}）`;
      document.getElementById('current-age-marker').textContent = `${petAge}歲`;
      document.getElementById('progress-bar').style.width = `${progress}%`;

      // Health recommendations
      const recs = [];
      recs.push({ icon: 'ℹ️', color: 'blue', text: '此範圍不是對個別寵物健康或剩餘壽命的預測，請把結果作為與獸醫討論照護規劃的起點。' });
      if (spayed) recs.push({ icon: '✓', color: 'green', text: '已結紮狀態已記錄為健康背景資訊；本工具不會把它換算成特定壽命差異。' });
      if ((document.getElementById('regular-vet') as HTMLInputElement).checked) recs.push({ icon: '✓', color: 'green', text: '定期獸醫檢查有助於討論個別預防照護計畫，但不會改變本站計算數值。' });
      if ((document.getElementById('overweight') as HTMLInputElement).checked) recs.push({ icon: 'ℹ️', color: 'blue', text: '如有過重或肥胖疑慮，可與獸醫討論體態及健康管理；本工具不會推算少活幾年。' });
      if (lifeStage.stage === '老年期') recs.push({ icon: '💬', color: 'blue', text: '可在下次獸醫諮詢時討論年齡、生活品質與適合該寵物的預防照護安排。' });

      const recsHtml = recs.map(r => `
        <div class="flex gap-3 p-3 ${r.color === 'green' ? 'bg-green-50' : 'bg-blue-50'} rounded-xl">
          <span class="${r.color === 'green' ? 'text-green-600' : r.color === 'yellow' ? 'text-yellow-600' : r.color === 'red' ? 'text-red-600' : 'text-blue-600'} text-lg">${r.icon}</span>
          <p class="text-sm text-slate-700">${r.text}</p>
        </div>
      `).join('');
      document.getElementById('health-recommendations').innerHTML = recsHtml;

      // Show results
      document.getElementById('results-section').classList.remove('hidden');
      document.getElementById('results-section').scrollIntoView({ behavior: 'smooth' });
    }

    // Event listeners
    document.querySelectorAll('.pet-type-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        clearCategoryError();
        document.querySelectorAll('.pet-type-btn').forEach(b => {
          b.classList.remove('border-emerald-500', 'bg-emerald-50');
          b.classList.add('border-slate-200');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.remove('border-slate-200');
        btn.classList.add('border-emerald-500', 'bg-emerald-50');
        btn.setAttribute('aria-pressed', 'true');

        petType = btn.dataset.type;
        document.getElementById('dog-breed-section').classList.toggle('hidden', petType !== 'dog');
        document.getElementById('cat-weight-section').classList.toggle('hidden', petType !== 'cat');
      });
    });

    document.getElementById('dog-breed').addEventListener('change', (e) => {
      clearCategoryError();
      dogBreed = e.target.value;
      document.getElementById('mixed-weight-section').classList.toggle('hidden', dogBreed !== 'mixed');
      document.getElementById('mixed-weight-hint').classList.toggle('hidden', dogBreed !== 'mixed');
    });

    document.getElementById('cat-type').addEventListener('change', (e) => {
      clearCategoryError();
      catType = e.target.value;
    });

    document.getElementById('mixed-weight').addEventListener('change', (e) => {
      mixedWeight = (e.target as HTMLInputElement).valueAsNumber;
    });

    document.getElementById('pet-age').addEventListener('change', (e) => {
      petAge = (e.target as HTMLInputElement).valueAsNumber;
    });

    document.getElementById('spayed').addEventListener('change', (e) => {
      spayed = e.target.checked;
    });

    document.getElementById('calculate-btn').addEventListener('click', calculate);
  </script>
</BaseLayout>
