---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "貓咪年齡計算機 | 人類年齡教育性估算";
const description = "以透明的教育性模型估算貓咪的人類年齡對應，並提供貓咪生命階段的參考資訊。";
const canonicalPath = "/tools/cat-age-calculator";
const canonicalURL = new URL(canonicalPath, "https://www.petaginghub.com/");

const breadcrumbs = [
  { label: '工具集', url: '/tools' },
  { label: '貓咪年齡計算機', url: canonicalPath }
];

const lifeStages = [
  { range: '未滿 1 歲', human: '幼貓期', stage: 'kitten' },
  { range: '1–未滿 7 歲', human: '青年成貓期', stage: 'young' },
  { range: '7–10 歲（含）', human: '成熟成貓期', stage: 'adult' },
  { range: '超過 10 歲', human: '老年期', stage: 'senior' }
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>

  <header class="max-w-4xl mx-auto px-6 pt-10 pb-8">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-4xl">🐱</span>
      <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">教育性估算</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
      貓咪年齡計算機
    </h1>
    <p class="text-lg text-slate-600 leading-relaxed max-w-2xl">
      想知道您的愛貓約等於人類幾歲嗎？本工具提供透明的人類年齡教育性估算與生命階段參考，不是獸醫評估。
    </p>
  </header>

  <section class="max-w-4xl mx-auto px-6 mb-10">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
      <div class="max-w-sm mx-auto text-center">
        <div class="mb-6">
          <label for="catAge" class="block text-sm font-semibold text-slate-700 mb-2">貓咪目前歲數</label>
          <input type="number" id="catAge" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-center text-lg" value="3" min="0" max="30" step="0.01" />
        </div>
        <div class="bg-gradient-to-b from-blue-50 to-slate-50 rounded-xl p-6 mb-4">
          <p class="text-sm text-slate-500 mb-2">對應人類年齡</p>
          <p class="text-5xl font-black text-blue-600 mb-2" id="result">28 歲</p>
          <p class="text-sm text-slate-500" id="lifeStageText">已進入青年成貓期</p>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-4 relative overflow-hidden border border-slate-200">
          <div id="progressFill" class="h-full transition-all duration-700 bg-blue-600 rounded-full" style="width: 15%"></div>
          <div class="absolute inset-0 flex justify-between px-2 text-[9px] text-slate-400 font-medium items-center uppercase tracking-wider">
            <span>幼年</span><span>成年</span><span>熟齡</span><span>老年</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 flex items-start gap-4">
      <div class="text-blue-600 mt-0.5">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-slate-800">透明的教育性模型</p>
        <p class="text-sm text-slate-500 mt-0.5">人類年齡換算由 Pet Aging Hub 定義：第 1 年約 15 歲、第 2 年約 24 歲，之後每年約增加 4 歲；這不是 AAHA、AAFP 或 AVMA 的官方換算公式。</p>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">為什麼了解貓咪的「人類年齡」很重要？</h2>
    <div class="prose prose-slate max-w-none space-y-4">
      <p class="text-slate-600">貓咪在生命前兩年的成長較快，因此本站用分段模型估算人類年齡對應值，但這不代表個別貓咪的生理年齡。不同階段的飲食與照護應考慮健康狀況；不要僅因年齡增加就自行改用限制磷或鈉的飲食，請先諮詢獸醫。</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">計算方法說明</h2>
    <div class="bg-white border border-slate-200 rounded-xl p-6 space-y-4">
      <div class="bg-slate-50 rounded-lg p-4 font-mono text-sm">
        <p class="font-semibold text-slate-700 mb-2">計算公式：</p>
        <p class="text-slate-600">第一年（1歲）= 15 歲 | 第二年（2歲）= 24 歲 | 第三年起每年 = +4 歲/年</p>
      </div>
      <div class="bg-slate-50 rounded-lg p-4 text-sm text-slate-600 space-y-1">
        <p>1歲→15歲 | 2歲→24歲 | 5歲→36歲 | 7歲→44歲 | 10歲→56歲 | 15歲→76歲</p>
      </div>
      <p class="text-xs text-slate-500">生命階段參考：2021 AAHA/AAFP Feline Life Stage Guidelines。該指引用於生命階段照護，不是本換算表的官方公式。</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">貓咪生命階段與照護重點</h2>
    <div class="grid gap-4">
      {lifeStages.map((stage) => (
        <div class="bg-white border border-slate-200 rounded-xl p-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class={`inline-block text-xs font-bold px-2 py-0.5 rounded mb-2 ${stage.stage === 'kitten' ? 'bg-pink-100 text-pink-700' : stage.stage === 'young' ? 'bg-orange-100 text-orange-700' : stage.stage === 'adult' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}`}>{stage.range}</span>
              <p class="text-slate-600">{stage.human}</p>
            </div>
            <div class={`w-3 h-3 rounded-full mt-1.5 ${stage.stage === 'kitten' ? 'bg-pink-400' : stage.stage === 'young' ? 'bg-orange-400' : stage.stage === 'adult' ? 'bg-green-400' : 'bg-yellow-400'}`}></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">常見問題</h2>
    <div class="space-y-4">
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">為什麼貓咪第二年只加 9 歲，而不是每年都加 4 歲？</summary>
        <div class="px-5 pb-5 text-slate-600">因為貓咪第一年的發育極快（約等於人類 15 年），第二年繼續快速發育（約再加 9 年，達到 24 歲）。從第三年起，發育速度趨於穩定，每年約增加 4 年。</div>
      </details>
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">室內貓和室外貓的老化速度有差別嗎？</summary>
        <div class="px-5 pb-5 text-slate-600">一般而言，室內貓因為生活環境較安全、營養較穩定、醫療資源較容易取得，平均壽命較室外貓長。但室內貓可能因活動空間有限而較少運動，需要注意體重管理。</div>
      </details>
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">貓咪幾歲算進入老年期？</summary>
        <div class="px-5 pb-5 text-slate-600">2021 AAHA/AAFP 生命階段指引將 7–10 歲（含）列為成熟成貓，超過 10 歲列為老年貓。年齡只是參考；個別照護與檢查安排請和獸醫討論。</div>
      </details>
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">老年貓的飲食需要注意什麼？</summary>
        <div class="px-5 pb-5 text-slate-600">年齡本身不能決定是否需要更換食物或處方飲食。飲食調整應依個別健康狀況、體態與獸醫建議決定。</div>
      </details>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">相關計算機與延伸閱讀</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <a href="/tools/dog-age-calculator/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-2"><span class="text-2xl">🐶</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">狗狗年齡計算機</span></div>
        <p class="text-sm text-slate-500">以體型分段的教育性模型估算愛犬的人類年齡對應。</p>
      </a>
      <a href="/blog/cat-aging-signs/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-2 mb-2"><span class="text-lg">📖</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">貓咪老化徵兆：7個預示愛貓進入熟齡期的變化</span></div>
        <p class="text-sm text-slate-500">從跳躍高度下降、隱藏時間變長到理毛頻率減少，解析7個貓咪常見老化徵兆。</p>
      </a>
      <a href="/blog/senior-pet-health-guide/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-2 mb-2"><span class="text-lg">🏥</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">老年犬貓的健康照護指南</span></div>
        <p class="text-sm text-slate-500">了解老年貓常見健康風險與科學照護流程。</p>
      </a>
      <a href="/blog/pet-nutrition-by-age/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-2 mb-2"><span class="text-lg">🍖</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">寵物各年齡階段的營養需求完整指南</span></div>
        <p class="text-sm text-slate-500">了解各生命階段的飲食考量，並依個別健康狀況與獸醫建議調整。</p>
      </a>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="border-t border-slate-200 pt-8">
      <p class="text-xs text-slate-500 leading-relaxed"><strong>免責聲明：</strong>本工具提供一般教育性估算，不構成獸醫建議、診斷或治療。貓咪的健康與老化可能和任何圖表不同；如有行為、食慾、行動或健康變化，請諮詢執業獸醫師。</p>
    </div>
  </section>

  <nav class="max-w-4xl mx-auto px-6 pb-12 flex justify-between items-center text-sm">
    <a href="/tools/dog-age-calculator/" class="text-blue-600 hover:text-blue-700 font-medium">← 狗狗年齡計算機</a>
    <a href="/tools/" class="text-blue-600 hover:text-blue-700 font-medium">所有工具 →</a>
  </nav>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebApplication","name":"貓咪年齡計算機","description":"以透明教育性模型估算貓咪的人類年齡對應與生命階段參考。","url":canonicalURL,"applicationCategory":"UtilitiesApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}})} />

  <script>
    import { estimateCatHumanAge, getCatLifeStage } from '../../utils/agingModel';
    const ageInput = document.getElementById('catAge') as HTMLInputElement;
    const resultDisplay = document.getElementById('result');
    const lifeStageText = document.getElementById('lifeStageText');
    const progressFill = document.getElementById('progressFill');
    const getStage = (age: number): { text: string; progress: number } => {
      const labels = { kitten: '幼貓期', youngAdult: '青年成貓期', matureAdult: '成熟成貓期', senior: '老年期' };
      return { text: labels[getCatLifeStage(age)], progress: Math.min(100, Math.max(5, age * 8)) };
    };
    const update = () => {
      const age = Number.parseFloat(ageInput.value) || 0;
      const humanAge = estimateCatHumanAge(age);
      const { text, progress } = getStage(age);
      if (resultDisplay) resultDisplay.textContent = `${humanAge} 歲`;
      if (lifeStageText) lifeStageText.textContent = `已進入 ${text}`;
      if (progressFill) progressFill.style.width = `${progress}%`;
    };
    ageInput.addEventListener('input', update);
    update();
  </script>
</BaseLayout>
