---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatAgeCalculator from '../../components/CatAgeCalculator.astro';
const title = '貓咪年齡計算機：貓歲與人類年齡教育性對照';
const description = '輸入貓咪年齡，查看人類年齡教育性估算與一般年齡階段參考。支援小數年齡；不預測健康、疾病或壽命。';
const breadcrumbs = [{ label: '工具集', url: '/tools' }, { label: '貓咪年齡計算機', url: '/tools/cat-age-calculator' }];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <CatAgeCalculator lang="zh-TW" />
</BaseLayout>
