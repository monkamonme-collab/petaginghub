---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';
import { dogSizeBands, getDogSizeLabel } from '../../utils/agingModel';

const currentPath = Astro.url.pathname;

const siteUrl = "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/tools/compare-aging' },
  { lang: 'x-default', url: siteUrl + '/tools/compare-aging' },
];
---

<BaseLayout
  title="狗與貓年齡比較：輸入年齡一次對照兩種寵物的人類年齡"
  description="比較你家狗狗和貓咪的年齡與生命階段。輸入年齡後同時顯示狗與貓的人類年齡對照，並提供個別的詳細老化指南連結。"
  breadcrumbs={[{ label: '工具集', url: '/tools' }, { label: '狗貓年齡比較', url: currentPath }]}
 lang="zh-TW" hrefLangAlternates={hrefLangAlternates}>
  <!-- Hero Section -->
  <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white">
    <div class="max-w-5xl mx-auto px-6 py-16 text-center">
      <div class="inline-flex items-center gap-2 bg-blue-500/20 border border-blue-400/30 rounded-full px-4 py-1.5 text-sm text-blue-300 mb-6">
        <span>🐕 🐱</span>
        <span>一次比較兩種寵物的年齡</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6 leading-tight">
        狗與貓年齡<br class="hidden md:block" />
        <span class="bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent">
          完整比較工具
        </span>
      </h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto mb-10">
        同時計算你家狗狗和貓咪的人類年齡教育性估算，並以體型作為狗狗估算的參考。這不是診斷或官方獸醫公式。
      </p>

      <!-- Main Calculator Form -->
      <div class="max-w-xl mx-auto bg-white/10 backdrop-blur-sm rounded-3xl p-8 border border-white/20">
        <div class="grid md:grid-cols-2 gap-4 mb-6">
          <!-- Dog Input -->
          <div class="text-left">
            <label for="dog-age" class="block text-sm text-slate-300 mb-2 font-medium">🐕 狗狗年齡（歲）</label>
            <input
              type="number"
              id="dog-age"
              min="0"
              max="30"
              step="0.01"
              value="5"
              class="w-full px-4 py-3 bg-white/20 border border-white/30 rounded-xl text-white text-lg focus:outline-none focus:ring-2 focus:ring-blue-400 placeholder-slate-400"
              placeholder="輸入狗狗年齡"
            />
          </div>
          <div class="text-left">
            <label for="dog-size" class="block text-sm text-slate-300 mb-2 font-medium">狗狗成年體型</label>
            <select id="dog-size" class="w-full px-4 py-3 bg-slate-800 border border-white/30 rounded-xl text-white text-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
              {dogSizeBands.map(({ size }) => <option value={size} selected={size === 'medium'}>{getDogSizeLabel(size, 'zh')}</option>)}
            </select>
          </div>
          <!-- Cat Input -->
          <div class="text-left">
            <label for="cat-age" class="block text-sm text-slate-300 mb-2 font-medium">🐱 貓咪年齡（歲）</label>
            <input
              type="number"
              id="cat-age"
              min="0"
              max="30"
              step="0.01"
              value="5"
              class="w-full px-4 py-3 bg-white/20 border border-white/30 rounded-xl text-white text-lg focus:outline-none focus:ring-2 focus:ring-indigo-400 placeholder-slate-400"
              placeholder="輸入貓咪年齡"
            />
          </div>
        </div>

        <button
          id="compare-btn"
          class="w-full py-4 bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 text-white font-bold text-lg rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl"
        >
          比較年齡 →
        </button>
      </div>
    </div>
  </div>

  <!-- Results Section (hidden until calculated) -->
  <div id="results-section" class="max-w-5xl mx-auto px-6 py-16 hidden">
    <div class="text-center mb-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">比較結果</h2>
      <p class="text-slate-500">以下為你家狗狗與貓咪的人類年齡對照</p>
    </div>

    <!-- Age Comparison Cards -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <!-- Dog Result Card -->
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl p-6 border border-blue-200">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">🐕</span>
          <div>
            <h3 class="font-bold text-slate-900">狗狗年齡</h3>
            <p class="text-sm text-blue-600" id="dog-stage-label">中型犬 · 成年期</p>
          </div>
        </div>
        <div class="text-center py-6">
          <p class="text-sm text-slate-500 mb-1">人類年齡對照</p>
          <p class="text-6xl font-extrabold text-blue-700" id="dog-human-age">36</p>
          <p class="text-lg text-slate-600 mt-1">歲</p>
        </div>
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">生命階段</span>
            <span class="font-medium text-blue-700" id="dog-life-stage">成年期</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">建議健康檢查</span>
            <span class="font-medium text-blue-700" id="dog-checkup">請與獸醫討論</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">距離老年還需</span>
            <span class="font-medium text-blue-700" id="dog-years-left">計算後顯示</span>
          </div>
        </div>
        <a
          href="/tools/dog-age-calculator/"
          class="mt-6 block w-full py-3 bg-blue-600 hover:bg-blue-700 text-white text-center rounded-xl font-semibold transition-colors"
        >
          查看完整狗狗年齡計算機 →
        </a>
      </div>

      <!-- Cat Result Card -->
      <div class="bg-gradient-to-br from-indigo-50 to-purple-100 rounded-2xl p-6 border border-indigo-200">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">🐱</span>
          <div>
            <h3 class="font-bold text-slate-900">貓咪年齡</h3>
            <p class="text-sm text-indigo-600" id="cat-stage-label">室內貓 · 成熟期</p>
          </div>
        </div>
        <div class="text-center py-6">
          <p class="text-sm text-slate-500 mb-1">人類年齡對照</p>
          <p class="text-6xl font-extrabold text-indigo-700" id="cat-human-age">36</p>
          <p class="text-lg text-slate-600 mt-1">歲</p>
        </div>
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">生命階段</span>
            <span class="font-medium text-indigo-700" id="cat-life-stage">成熟期</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">建議健康檢查</span>
            <span class="font-medium text-indigo-700" id="cat-checkup">請與獸醫討論</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">一般老年分類參考</span>
            <span class="font-medium text-indigo-700" id="cat-years-left">超過 10 歲；老化是漸進過程</span>
          </div>
        </div>
        <a
          href="/tools/cat-age-calculator/"
          class="mt-6 block w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white text-center rounded-xl font-semibold transition-colors"
        >
          查看完整貓咪年齡計算機 →
        </a>
      </div>
    </div>

    <!-- Summary Banner -->
    <div class="bg-slate-100 rounded-2xl p-6 text-center">
      <p class="text-slate-700 font-medium" id="summary-text">
        輸入年齡後查看本站教育性對照結果；人類年齡換算並非生理年齡或診斷。
      </p>
      <p class="text-sm text-slate-500 mt-3">
        了解更詳細的
        <a href="/blog/dog-vs-cat-aging/" class="text-blue-600 hover:text-blue-800 underline">
          狗與貓老化差異完整分析
        </a>
        →
      </p>
    </div>
  </div>

  <!-- Comparison Reference Table -->
  <div class="bg-slate-50 border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-6 py-16">
      <h2 class="text-2xl font-bold text-slate-900 text-center mb-8">
        狗與貓年齡對照表（常見年齡快速查詢）
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="bg-slate-200">
              <th class="px-4 py-3 font-semibold text-slate-700 rounded-tl-lg">年份</th>
              <th class="px-4 py-3 font-semibold text-slate-700">🐕 小型犬</th>
              <th class="px-4 py-3 font-semibold text-slate-700">🐕 中型犬</th>
              <th class="px-4 py-3 font-semibold text-slate-700">🐕 大型犬</th>
              <th class="px-4 py-3 font-semibold text-slate-700">🐕 巨型犬</th>
              <th class="px-4 py-3 font-semibold text-slate-700 rounded-tr-lg">🐱 室內貓</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200" id="comparison-table-body">
            <!-- Populated by JS -->
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500 text-center mt-4">
        * 狗狗體型分類：{dogSizeBands.map(({ size }) => getDogSizeLabel(size, 'zh')).join('、')}。分類是本站估算假設，非官方標準。
      </p>
      <div class="text-center mt-6">
        <a
          href="/blog/dog-vs-cat-aging/"
          class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium"
        >
          了解更多狗與貓老化差異 →
        </a>
      </div>
    </div>
  </div>

  <AdSenseAd format="in-article" />

  <!-- Related Content -->
  <div class="max-w-5xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-bold text-slate-900 text-center mb-8">
      相關內容推薦
    </h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Dog Calculator -->
      <a href="/tools/dog-age-calculator/" class="group bg-white rounded-2xl p-6 border border-slate-200 hover:border-blue-300 hover:shadow-lg transition-all">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">🐕</span>
          <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-bold rounded-full">工具</span>
        </div>
        <h3 class="font-bold text-slate-900 mb-2 group-hover:text-blue-700">狗狗年齡計算機</h3>
        <p class="text-sm text-slate-600">以體型分段的教育性模型，提供人類年齡與生命階段參考</p>
      </a>

      <!-- Cat Calculator -->
      <a href="/tools/cat-age-calculator/" class="group bg-white rounded-2xl p-6 border border-slate-200 hover:border-indigo-300 hover:shadow-lg transition-all">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">🐱</span>
          <span class="px-2 py-1 bg-indigo-100 text-indigo-700 text-xs font-bold rounded-full">工具</span>
        </div>
        <h3 class="font-bold text-slate-900 mb-2 group-hover:text-indigo-700">貓咪年齡計算機</h3>
        <p class="text-sm text-slate-600">了解愛貓的生命階段與照護重點，快速對照人類年齡</p>
      </a>

      <!-- Comparison Article -->
      <a href="/blog/dog-vs-cat-aging/" class="group bg-white rounded-2xl p-6 border border-slate-200 hover:border-amber-300 hover:shadow-lg transition-all">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">📊</span>
          <span class="px-2 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">文章</span>
        </div>
        <h3 class="font-bold text-slate-900 mb-2 group-hover:text-amber-700">狗與貓老化差異完整比較</h3>
        <p class="text-sm text-slate-600">從壽命、衰老速度到照護重點，全面解析兩種寵物的老化歷程</p>
      </a>

      <!-- Dog Aging Signs -->
      <a href="/blog/dog-aging-signs/" class="group bg-white rounded-2xl p-6 border border-slate-200 hover:border-amber-300 hover:shadow-lg transition-all">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">🐕</span>
          <span class="px-2 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">文章</span>
        </div>
        <h3 class="font-bold text-slate-900 mb-2 group-hover:text-amber-700">狗狗老化徵兆完整指南</h3>
        <p class="text-sm text-slate-600">7個不可忽視的狗狗老化徵兆與應對策略</p>
      </a>

      <!-- Cat Aging Signs -->
      <a href="/blog/cat-aging-signs/" class="group bg-white rounded-2xl p-6 border border-slate-200 hover:border-purple-300 hover:shadow-lg transition-all">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">🐱</span>
          <span class="px-2 py-1 bg-purple-100 text-purple-700 text-xs font-bold rounded-full">文章</span>
        </div>
        <h3 class="font-bold text-slate-900 mb-2 group-hover:text-purple-700">貓咪老化徵兆完整指南</h3>
        <p class="text-sm text-slate-600">7個預示愛貓進入熟齡期的身體與行為變化</p>
      </a>

      <!-- Senior Pet Guide -->
      <a href="/blog/senior-pet-health-guide/" class="group bg-white rounded-2xl p-6 border border-slate-200 hover:border-purple-300 hover:shadow-lg transition-all">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">📋</span>
          <span class="px-2 py-1 bg-purple-100 text-purple-700 text-xs font-bold rounded-full">文章</span>
        </div>
        <h3 class="font-bold text-slate-900 mb-2 group-hover:text-purple-700">老年寵物健康完整指南</h3>
        <p class="text-sm text-slate-600">從營養到居家環境調整，貓狗都適用的全方位老年照護攻略</p>
      </a>
    </div>
  </div>

  <script>
    import { estimateDogHumanAge, estimateCatHumanAge, getDogLifeStage, getCatLifeStage, getDogSeniorAge } from '../../utils/agingModel';
    // Educational age-equivalence helpers are shared with the individual calculators.
    function dogToHuman(years, size = 'medium') {
      return estimateDogHumanAge(years, size as 'small' | 'medium' | 'large' | 'giant');
    }

    function catToHuman(years) {
      return estimateCatHumanAge(years);
    }

    const dogStageLabels = { puppy: '幼年期', adult: '成年期', senior: '老年期' };
    const catStageLabels = { kitten: '幼貓期', youngAdult: '青年成貓期', matureAdult: '成熟成貓期', senior: '老年期' };

    function getYearsToSenior(years, isCat = false, dogSize = 'medium') {
      const threshold = isCat ? 10 : getDogSeniorAge(dogSize as 'small' | 'medium' | 'large' | 'giant');
      if (isCat && years === 10) return '10 歲後';
      const diff = threshold - years;
      if (diff <= 0) return '已進入';
      if (diff < 1) return '不到1年';
      return `約${Math.round(diff)}年`;
    }

    function calculate() {
      const dogAge = parseFloat(document.getElementById('dog-age').value) || 0;
      const catAge = parseFloat(document.getElementById('cat-age').value) || 0;
      const dogSize = document.getElementById('dog-size').value as 'small' | 'medium' | 'large' | 'giant';

      if (dogAge <= 0 || catAge <= 0) return;

      const dogHumanAge = estimateDogHumanAge(dogAge, dogSize);
      const catHumanAge = estimateCatHumanAge(catAge);

      // Update DOM
      document.getElementById('dog-human-age').textContent = dogHumanAge;
      const dogStage = getDogLifeStage(dogAge, dogSize);
      const catStage = getCatLifeStage(catAge);
      document.getElementById('dog-life-stage').textContent = dogStageLabels[dogStage];
      document.getElementById('dog-stage-label').textContent = `狗狗 · ${dogStageLabels[dogStage]}`;
      document.getElementById('dog-checkup').textContent = '請與獸醫討論';
      document.getElementById('dog-years-left').textContent = getYearsToSenior(dogAge, false, dogSize);

      document.getElementById('cat-human-age').textContent = catHumanAge;
      document.getElementById('cat-life-stage').textContent = catStageLabels[catStage];
      document.getElementById('cat-stage-label').textContent = `貓咪 · ${catStageLabels[catStage]}`;
      document.getElementById('cat-checkup').textContent = '請與獸醫討論';
      document.getElementById('cat-years-left').textContent = '超過 10 歲；不是生理切換點';

      // Summary text
      let summary = '';
      if (dogAge > catAge + 1) {
        summary = `狗狗的實際年齡比貓咪大 ${(dogAge - catAge).toFixed(1)} 歲；上方顯示各自的人類年齡教育性對照與生命階段。`;
      } else if (catAge > dogAge + 1) {
        summary = `貓咪的實際年齡比狗狗大 ${(catAge - dogAge).toFixed(1)} 歲；上方顯示各自的人類年齡教育性對照與生命階段。`;
      } else {
        summary = `狗狗和貓咪的實際年齡相近；人類年齡對照不能代表個別寵物的生理年齡或健康狀況。`;
      }
      document.getElementById('summary-text').textContent = summary;

      // Show results
      document.getElementById('results-section').classList.remove('hidden');

      // Scroll to results
      document.getElementById('results-section').scrollIntoView({ behavior: 'smooth' });
    }

    // Build comparison table
    function buildComparisonTable() {
      const tbody = document.getElementById('comparison-table-body');
      const rows = [1, 2, 3, 5, 7, 10, 12, 15];

      rows.forEach(year => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="px-4 py-3 font-medium text-slate-700">${year}歲</td>
          <td class="px-4 py-3 text-slate-600">${dogToHuman(year, 'small')}歲</td>
          <td class="px-4 py-3 text-slate-600">${dogToHuman(year, 'medium')}歲</td>
          <td class="px-4 py-3 text-slate-600">${dogToHuman(year, 'large')}歲</td>
          <td class="px-4 py-3 text-slate-600">${dogToHuman(year, 'giant')}歲</td>
          <td class="px-4 py-3 text-slate-600">${catToHuman(year)}歲</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Event listeners
    document.getElementById('compare-btn').addEventListener('click', calculate);

    document.getElementById('dog-age').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') calculate();
    });
    document.getElementById('cat-age').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') calculate();
    });

    // Initialize
    buildComparisonTable();
    calculate();
  </script>
</BaseLayout>
