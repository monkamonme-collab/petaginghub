---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DogAgeCalculator from '../../components/DogAgeCalculator.astro';
const title = "狗狗年齡計算機：依體型估算人類年齡";
const description = "輸入狗狗歲數與成年體型，取得教育性人類年齡估算、一般年齡階段與老年參考。支援小數年齡，附方法、對照表與限制說明。";
const breadcrumbs = [
  { label: '工具集', url: '/tools/' },
  { label: '狗狗年齡計算機', url: '/tools/dog-age-calculator/' },
];
---
<BaseLayout title={title} description={description} lang="zh-TW" breadcrumbs={breadcrumbs}>
  <header class="max-w-4xl mx-auto sm:px-6 pt-10 pb-6">
    <span class="inline-block text-sm font-medium text-blue-700 bg-blue-50 px-3 py-1 rounded-full mb-3">教育性估算</span>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">狗狗年齡計算機</h1>
    <p class="text-lg text-slate-600 leading-relaxed">輸入狗狗歲數與成年體型，取得人類對應年齡的教育性估算，以及本站簡化年齡階段參考。</p>
  </header>
  <DogAgeCalculator lang="zh" />
</BaseLayout>
