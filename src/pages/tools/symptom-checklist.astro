---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';

const currentPath = Astro.url.pathname;

const siteUrl = Astro.site?.origin ?? "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/tools/symptom-checklist' },
  { lang: 'x-default', url: siteUrl + '/tools/symptom-checklist' },
];
---

<BaseLayout
  title="寵物症狀檢核表：整理狗狗貓咪的變化與就醫警訊"
  description="整理觀察到的症狀，辨識需立即求助的警訊，並準備與獸醫討論的紀錄。本工具不診斷疾病或計算風險分數。"
  breadcrumbs={[{ label: '工具集', url: '/tools' }, { label: '寵物症狀檢核表', url: currentPath }]}
 lang="zh-TW" hrefLangAlternates={hrefLangAlternates}>
  <div class="bg-gradient-to-br from-red-50 to-orange-50 border-b border-red-100">
    <div class="max-w-5xl mx-auto px-6 py-12 text-center">
      <div class="inline-flex items-center gap-2 bg-red-100 text-red-800 text-xs font-bold px-3 py-1.5 rounded-full mb-4">
        ⚠️ 症狀整理工具
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-4 leading-tight">
        寵物症狀檢核表
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        勾選觀察到的變化，整理與獸醫討論的紀錄。本工具不計算健康風險，也不能排除疾病；出現急症警訊請立即求助，不要等待填完。
      </p>
    </div>
  </div>

  <!-- Disclaimer Banner -->
  <div class="bg-amber-50 border-b border-amber-200">
    <div class="max-w-5xl mx-auto px-6 py-4">
      <div class="flex items-start gap-3">
        <span class="text-2xl">⚠️</span>
        <div>
          <p class="font-bold text-amber-800 text-sm">重要提醒</p>
          <p class="text-xs text-amber-700">
            本檢核表僅供參考，不能取代獸醫診斷。如果你觀察到任何緊急症狀（如呼吸困難、意識喪失、大量出血），請立即就醫。
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-12">
    <!-- Pet Type Selection -->
    <div class="max-w-xl mx-auto mb-10">
      <div class="grid grid-cols-2 gap-4">
        <button
          type="button"
          id="type-dog"
          class="symptom-type-btn flex flex-col items-center gap-2 p-6 rounded-2xl border-2 border-slate-200 hover:border-red-300 hover:bg-red-50 transition-all"
          data-type="dog"
        >
          <span class="text-5xl">🐕</span>
          <span class="font-bold text-slate-700">狗狗</span>
        </button>
        <button
          type="button"
          id="type-cat"
          class="symptom-type-btn flex flex-col items-center gap-2 p-6 rounded-2xl border-2 border-slate-200 hover:border-purple-300 hover:bg-purple-50 transition-all"
          data-type="cat"
        >
          <span class="text-5xl">🐱</span>
          <span class="font-bold text-slate-700">貓咪</span>
        </button>
      </div>
    </div>

    <!-- Symptom Checklist -->
    <div id="checklist-section" class="hidden">
      <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden">
          <div class="bg-gradient-to-r from-red-500 to-orange-500 p-6 text-white">
            <h2 class="text-xl font-bold flex items-center gap-2">
              <span>📋</span> 勾選觀察到的症狀
            </h2>
            <p class="text-sm text-red-100 mt-1">可複選。數量不代表風險高低；單一急症警訊也需要立即求助。</p>
          </div>

          <div class="p-8 space-y-8">
            <!-- Section 1: General -->
            <div>
              <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center text-sm">1</span>
                整體活力與行為
              </h3>
              <div class="grid md:grid-cols-2 gap-3">
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="general" data-symptom="lethargy" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">精神不振/嗜睡</span>
                    <p class="text-xs text-slate-500">比平常更累，不想互動</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="general" data-symptom="no-appetite" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">食慾減退</span>
                    <p class="text-xs text-slate-500">拒絕進食或食量明顯下降；貓咪不吃東西應盡快聯絡獸醫，不要等滿固定天數</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="general" data-symptom="drinking-more" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">喝水量異常增加</span>
                    <p class="text-xs text-slate-500">頻繁喝水，尿量也增加</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="general" data-symptom="weight-loss" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">體重明顯減輕</span>
                    <p class="text-xs text-slate-500">在沒有減肥的情況下體重下降</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="general" data-symptom="collapse" />
                  <div>
                    <span class="text-sm font-medium text-red-700">虛脫/暈倒</span>
                    <p class="text-xs text-red-500">突發性倒下或失去意識</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="general" data-symptom="confusion" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">方向感混亂/迷失</span>
                    <p class="text-xs text-slate-500">在熟悉環境中找不到方向</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Section 2: Physical -->
            <div>
              <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center text-sm">2</span>
                外觀與身體變化
              </h3>
              <div class="grid md:grid-cols-2 gap-3">
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="physical" data-symptom="cloudy-eyes" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">眼睛混濁/變色</span>
                    <p class="text-xs text-slate-500">視力可能受影響</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="physical" data-symptom="grey-hair" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">毛髮提前變白/脫落</span>
                    <p class="text-xs text-slate-500">臉部周圍毛髮花白加劇</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="physical" data-symptom="lumps" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">皮膚有腫塊/腫瘤</span>
                    <p class="text-xs text-slate-500">新出現或快速增大的腫塊</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="physical" data-symptom="bad-breath" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">口臭/牙齦問題</span>
                    <p class="text-xs text-slate-500">牙齦紅腫、出血</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Section 3: Mobility -->
            <div>
              <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center text-sm">3</span>
                行動與關節
              </h3>
              <div class="grid md:grid-cols-2 gap-3">
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="mobility" data-symptom="slow-rise" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">起身困難/緩慢</span>
                    <p class="text-xs text-slate-500">起床時動作僵硬</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="mobility" data-symptom="stiff" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">關節僵硬</span>
                    <p class="text-xs text-slate-500">活動一段時間後才好轉</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="mobility" data-symptom="limping" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">跛行/不願負重</span>
                    <p class="text-xs text-slate-500">某隻腳不敢著地</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="mobility" data-symptom="hunched" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">背部拱起/姿勢異常</span>
                    <p class="text-xs text-slate-500">可能表示脊椎問題</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Section 4: Digestive -->
            <div>
              <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center text-sm">4</span>
                消化系統
              </h3>
              <div class="grid md:grid-cols-2 gap-3">
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="digestive" data-symptom="vomiting" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">嚴重或持續嘔吐</span>
                    <p class="text-xs text-slate-500">急症警訊：嚴重或持續嘔吐請立即求助</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="digestive" data-symptom="diarrhea" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">嚴重腹瀉伴血便或黑色柏油樣便</span>
                    <p class="text-xs text-slate-500">急症警訊：嚴重腹瀉伴紅色血液或黑色柏油樣便</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="digestive" data-symptom="bloating" />
                  <div>
                    <span class="text-sm font-medium text-red-700">腹部突然明顯膨脹或變硬</span>
                    <p class="text-xs text-red-500">尤其伴隨乾嘔、明顯不適或快速惡化時，請立即聯絡獸醫或動物急診。</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="digestive" data-symptom="constipation" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">便秘/如廁困難</span>
                    <p class="text-xs text-slate-500">排便困難或與平常習慣明顯不同；請向獸醫詢問合適的評估時機</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Section 5: Respiratory -->
            <div>
              <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center text-sm">5</span>
                呼吸系統
              </h3>
              <div class="grid md:grid-cols-2 gap-3">
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="respiratory" data-symptom="coughing" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">咳嗽/乾咳</span>
                    <p class="text-xs text-slate-500">新出現、持續或變嚴重的咳嗽；若伴呼吸困難請立即求助</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="respiratory" data-symptom="heavy-breathing" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">呼吸急促/困難</span>
                    <p class="text-xs text-slate-500">休息時也呼吸急促</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="respiratory" data-symptom="blue-gums" />
                  <div>
                    <span class="text-sm font-medium text-red-700">牙齦發藍、發紫或非常蒼白</span>
                    <p class="text-xs text-red-500">急症警訊：立即聯絡獸醫或急診</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="respiratory" data-symptom="wheezing" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">喘鳴/呼吸有聲</span>
                    <p class="text-xs text-slate-500">可能是氣管問題</p>
                  </div>
                </label>
              </div>
            </div>

            <!-- Section 6: Sensory -->
            <div>
              <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center text-sm">6</span>
                感官知覺
              </h3>
              <div class="grid md:grid-cols-2 gap-3">
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="sensory" data-symptom="hearing-loss" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">聽力減退</span>
                    <p class="text-xs text-slate-500">叫名字沒反應</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                  <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="sensory" data-symptom="vision-loss" />
                  <div>
                    <span class="text-sm font-medium text-slate-700">視力減退</span>
                    <p class="text-xs text-slate-500">晚上走路撞到東西</p>
                  </div>
                </label>
              </div>
            </div>

            <label class="flex items-start gap-3 p-3 rounded-xl border border-red-200 cursor-pointer">
              <input type="checkbox" class="symptom-checkbox mt-1 w-4 h-4 text-red-600 rounded" data-category="general" data-symptom="active-seizure" />
              <div><span class="text-sm font-medium text-red-700">正在抽搐或失去反應</span><p class="text-xs text-red-700">急症警訊：立即聯絡獸醫或動物急診，不要等待。</p></div>
            </label>
            <button
              type="button"
              id="evaluate-btn"
              class="w-full py-4 bg-gradient-to-r from-red-500 to-orange-500 hover:from-red-600 hover:to-orange-600 text-white font-bold text-lg rounded-xl transition-all shadow-lg"
            >
              查看觀察紀錄與求助提醒 →
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Results Section -->
    <div id="results-section" class="hidden mt-10 scroll-mt-20" aria-live="polite" aria-atomic="true" role="status">
      <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden">
          <div id="result-header" class="p-8 text-center">
            <!-- Filled by JS -->
          </div>
          <div id="result-details" class="p-8 border-t border-slate-200">
            <!-- Filled by JS -->
          </div>
        </div>

        <!-- Related Actions -->
        <div class="mt-8 grid md:grid-cols-2 gap-4">
          <a href="/blog/senior-pet-health-guide/" class="group bg-white rounded-2xl p-6 border border-slate-200 hover:border-emerald-300 hover:shadow-lg transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">📋</span>
              <span class="px-2 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full">文章</span>
            </div>
            <h3 class="font-bold text-slate-900 mb-1 group-hover:text-emerald-700">老年寵物健康指南</h3>
            <p class="text-sm text-slate-600">了解如何照護老年寵物的健康</p>
          </a>

          <a href="/blog/dog-aging-signs/" id="aging-signs-link" class="group bg-white rounded-2xl p-6 border border-slate-200 hover:border-amber-300 hover:shadow-lg transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">🔍</span>
              <span class="px-2 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">文章</span>
            </div>
            <h3 class="font-bold text-slate-900 mb-1 group-hover:text-amber-700">老化徵兆完整指南</h3>
            <p class="text-sm text-slate-600">學習識別寵物的老化徵兆</p>
          </a>
        </div>
      </div>
    </div>
  </div>

  <AdSenseAd format="in-article" />

  <p class="mt-6 text-sm text-slate-600">來源：<a href="https://www.vet.cornell.edu/hospitals/services/emergency-and-critical-care-0" class="underline">Cornell 急症警訊</a>；<a href="https://www.vet.cornell.edu/departments-centers-and-institutes/cornell-feline-health-center/health-information/feline-health-topics/anorexia" class="underline">Cornell 貓咪不食資訊</a>。來源支持上述警訊，不支持症狀計數風險分數。若正在抽搐、失去反應，或有未列出的明顯急症，請立即求助，不要等待填表。</p>
  <script>
    let petType = '';

    document.querySelectorAll('.symptom-type-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.symptom-type-btn').forEach(b => {
          b.classList.remove('border-red-500', 'bg-red-50', 'border-purple-500', 'bg-purple-50');
          b.classList.add('border-slate-200');
        });
        btn.classList.remove('border-slate-200');
        btn.classList.add(petType === 'dog' ? 'border-red-500' : 'border-purple-500', petType === 'dog' ? 'bg-red-50' : 'bg-purple-50');
        
        petType = btn.dataset.type;
        document.getElementById('checklist-section').classList.remove('hidden');

        // Update aging signs link
        document.getElementById('aging-signs-link').href = petType === 'dog' ? '/blog/dog-aging-signs/' : '/blog/cat-aging-signs/';
      });
    });

    document.getElementById('evaluate-btn').addEventListener('click', () => {
      const checked = Array.from(document.querySelectorAll('.symptom-checkbox:checked'));
      const emergencySigns = new Set(['collapse', 'heavy-breathing', 'blue-gums', 'vomiting', 'diarrhea', 'bloating', 'active-seizure']);
      const hasEmergency = checked.some(cb => emergencySigns.has(cb.dataset.symptom));
      const message = hasEmergency
        ? '已勾選急症警訊：請立即聯絡獸醫或動物急診，不要等待。'
        : checked.length > 0
          ? '請記錄症狀並聯絡獸醫，依嚴重度、持續情形、快速惡化及其他變化確認評估時機。貓咪不吃東西應盡快求助，不要等滿固定天數。'
          : '目前未勾選所列症狀。這不能確認寵物健康或排除疾病；若有疑慮或新變化，請聯絡獸醫。';
      document.getElementById('result-header').textContent = hasEmergency ? '請立即尋求急診協助' : '觀察紀錄與求助提醒';
      const details = document.getElementById('result-details');
      details.replaceChildren();
      const guidance = document.createElement('p');
      guidance.textContent = message;
      details.appendChild(guidance);
      const list = document.createElement('ul');
      list.className = 'mt-4 space-y-2';
      checked.forEach(cb => {
        const item = document.createElement('li');
        item.textContent = cb.closest('label').querySelector('span').textContent;
        list.appendChild(item);
      });
      details.appendChild(list);
      document.getElementById('results-section').classList.remove('hidden');
      document.getElementById('results-section').scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</BaseLayout>
