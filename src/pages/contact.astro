---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: '聯絡我們', url: '/contact/' }
];

const siteUrl = "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/contact' },
  { lang: 'x-default', url: siteUrl + '/contact' },
];
---

<BaseLayout
  title="聯絡我們 - Pet Aging Hub"
  description="如有任何關於寵物老化或健康問題的疑問，歡迎聯絡 Pet Aging Hub。"
  breadcrumbs={breadcrumbs}
 lang="zh-TW" hrefLangAlternates={hrefLangAlternates}>
  <div class="max-w-2xl mx-auto py-10">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-extrabold text-slate-900 mb-4">聯絡我們</h1>
      <p class="text-lg text-slate-600">有任何問題或建議？我們很樂意聽到您的聲音。</p>
    </header>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <div class="text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">📧</div>
        <h3 class="font-bold text-slate-900 mb-1">電子郵件</h3>
        <p class="text-sm text-slate-600">
          <a href="mailto:monkamonme@gmail.com" class="text-blue-600 hover:text-blue-700">透過電子郵件聯絡我們</a>
        </p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">⏱️</div>
        <h3 class="font-bold text-slate-900 mb-1">回覆時間</h3>
        <p class="text-sm text-slate-600">2-3 個工作日</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">🌐</div>
        <h3 class="font-bold text-slate-900 mb-1">位置</h3>
        <p class="text-sm text-slate-600">線上資源平台</p>
      </div>
    </div>

    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900 mb-6">傳送訊息</h2>
      <form id="contact-form" class="space-y-6">
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-2">電子郵件 <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-500 transition-colors" placeholder="your.email@example.com" />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-slate-700 mb-2">訊息內容 <span class="text-red-500">*</span></label>
          <textarea id="message" name="message" required rows="6" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-500 transition-colors resize-none" placeholder="請輸入您的訊息..."></textarea>
        </div>
        <button type="submit" id="submit-btn" class="w-full py-4 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-colors shadow-md">傳送訊息</button>
      </form>
      <div id="success-message" class="hidden text-center py-8">
        <div class="text-3xl mb-4">✅</div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">訊息已傳送</h3>
        <p class="text-slate-600">感謝您的來信！</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMessage = document.getElementById('success-message');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = '傳送中...';
      setTimeout(() => {
        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');
      }, 1000);
    });
  }
</script>
