---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { label: 'Home', url: '/en/' },  { label: 'Contact', url: '/en/contact/' }
];

const siteUrl = "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/contact' },
  { lang: 'en', url: siteUrl + '/en/contact' },
  { lang: 'x-default', url: siteUrl + '/contact' },
];
---

<BaseLayout
  title="Contact Us - Pet Aging Hub"
  description="Have a question about pet aging or health? Get in touch with Pet Aging Hub."
  lang="en"
  breadcrumbs={breadcrumbs}
  hrefLangAlternates={hrefLangAlternates}>

  <div class="max-w-2xl mx-auto py-10">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-extrabold text-slate-900 mb-4">Contact Us</h1>
      <p class="text-lg text-slate-600">Have a question or suggestion? We'd love to hear from you.</p>
    </header>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <div class="text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">📧</div>
        <h3 class="font-bold text-slate-900 mb-1">Email</h3>
        <p class="text-sm text-slate-600">
          <a href="mailto:monkamonme@gmail.com" class="text-blue-600 hover:text-blue-700">Contact us by email</a>
        </p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">⏱️</div>
        <h3 class="font-bold text-slate-900 mb-1">Response Time</h3>
        <p class="text-sm text-slate-600">2–3 business days</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">🌐</div>
        <h3 class="font-bold text-slate-900 mb-1">Location</h3>
        <p class="text-sm text-slate-600">Online resource platform</p>
      </div>
    </div>

    <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Send a Message</h2>
      <form id="contact-form" class="space-y-6">
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-2">Email <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-500 transition-colors" placeholder="your.email@example.com" />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-slate-700 mb-2">Message <span class="text-red-500">*</span></label>
          <textarea id="message" name="message" required rows="6" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-amber-500 transition-colors resize-none" placeholder="Type your message here..."></textarea>
        </div>
        <button type="submit" id="submit-btn" class="w-full py-4 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-colors shadow-md">Send Message</button>
      </form>
      <div id="success-message" class="hidden text-center py-8">
        <div class="text-3xl mb-4">✅</div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Message Sent</h3>
        <p class="text-slate-600">Thank you for reaching out!</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMessage = document.getElementById('success-message');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      setTimeout(() => {
        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');
      }, 1000);
    });
  }
</script>
