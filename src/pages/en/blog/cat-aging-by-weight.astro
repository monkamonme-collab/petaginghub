---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CatWeightGuide from '../../../components/CatWeightGuide.astro';
const title = 'Weight Changes in Aging Cats: Body and Muscle Condition';
const description = 'Understand weight trends, body condition, and muscle condition in older cats. Weight is health context, not a formula for biological age or lifespan.';
const siteUrl = 'https://www.petaginghub.com';
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/blog/cat-aging-by-weight' },
  { lang: 'en', url: siteUrl + '/en/blog/cat-aging-by-weight' },
  { lang: 'x-default', url: siteUrl + '/blog/cat-aging-by-weight' },
];
const breadcrumbs = [{ label: 'Blog', url: '/en/blog/' }, { label: 'Cat Weight Changes', url: '/en/blog/cat-aging-by-weight/' }];
---
<BaseLayout title={title} description={description} lang="en" breadcrumbs={breadcrumbs} hrefLangAlternates={hrefLangAlternates}>
  <CatWeightGuide lang="en" />
</BaseLayout>
