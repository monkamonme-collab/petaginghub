---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const breadcrumbs = [

  { label: 'Blog', url: '/en/blog/' }
];

const siteUrl = "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/blog/' },
  { lang: 'en', url: siteUrl + '/en/blog/' },
  { lang: 'x-default', url: siteUrl + '/blog/' },
];

function catBadge(color) {
  const map = {
    purple: 'bg-purple-100 text-purple-700',
    blue: 'bg-blue-100 text-blue-700',
    amber: 'bg-amber-100 text-amber-700',
    green: 'bg-green-100 text-green-700',
    teal: 'bg-teal-100 text-teal-700',
    red: 'bg-red-100 text-red-700',
    orange: 'bg-orange-100 text-orange-700',
  };
  return 'px-2 py-1 text-xs font-bold rounded-full ' + (map[color] || 'bg-slate-100 text-slate-700');
}

const articles = [
  { href: '/en/blog/senior-pet-health-guide/', cat: 'Featured', color: 'purple', title: 'Complete Guide to Senior Pet Health', desc: 'A comprehensive look at nutrition, exercise, environment, and preventive care for pets 7 years and older.', time: '~15 min', img: 'https://images.unsplash.com/photo-1581888227599-779811939961?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/dog-vs-cat-aging/', cat: 'Comparison', color: 'blue', title: 'Dog vs. Cat Aging: Full Comparison', desc: 'A 9-dimension comparison of aging speed, lifespan, common diseases, and senior care priorities.', time: '~10 min', img: 'https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/dog-aging-by-breed/', cat: 'Dogs', color: 'amber', title: 'Dog Aging by Breed and Size', desc: 'Aging timelines and life expectancy for 15+ breeds from Chihuahua to Great Dane.', time: '~12 min', img: 'https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/cat-aging-by-weight/', cat: 'Cats', color: 'purple', title: 'Weight Changes in Aging Cats', desc: 'Body condition, weight trends, and muscle condition in older cats—not an aging formula.', time: '~10 min', img: 'https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/cat-aging-signs/', cat: 'Cats', color: 'purple', title: 'Signs Your Cat Is Aging', desc: 'Behavioral, physical, and cognitive changes that signal your cat is entering their senior years.', time: '~8 min', img: 'https://images.unsplash.com/photo-1495360010541-f48722b34f7d?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/pet-nutrition-by-age/', cat: 'Nutrition', color: 'green', title: 'Pet Nutrition by Life Stage', desc: 'How your dog or cat nutritional needs change from youth through senior and what to feed at each stage.', time: '~12 min', img: 'https://images.unsplash.com/photo-1601758228041-f3b2795255f1?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/pet-exercise-by-age/', cat: 'Care', color: 'teal', title: 'Exercise Needs by Pet Age', desc: 'Age-appropriate activity levels for dogs and cats from playful youth to gentle senior.', time: '~10 min', img: 'https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/senior-dog-care/', cat: 'Dogs', color: 'amber', title: 'Senior Dog Care: A Complete Guide', desc: 'Vet schedules, diet adjustments, mobility support, and comfort care for dogs aged 7 and up.', time: '~14 min', img: 'https://images.unsplash.com/photo-1477884213360-7e9d7dcc1e48?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/senior-cat-care/', cat: 'Cats', color: 'purple', title: 'Senior Cat Care: A Complete Guide', desc: 'How to keep your cat healthy and comfortable through their senior and geriatric years.', time: '~12 min', img: 'https://images.unsplash.com/photo-1513360371669-4adf3dd7dff8?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/pet-dental-health/', cat: 'Health', color: 'blue', title: 'Dental Health in Senior Pets', desc: 'Why dental disease is so common and dangerous in aging pets, and what you can do about it.', time: '~8 min', img: 'https://images.unsplash.com/photo-1548767797-d8c844163c4c?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/when-to-see-vet/', cat: 'Health', color: 'red', title: 'When to See the Vet: Senior Pet Warning Signs', desc: 'Knowing when symptoms need urgent care vs. a scheduled checkup can make a real difference.', time: '~8 min', img: 'https://images.unsplash.com/photo-1628009368231-7bb7cfcb0def?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/pet-joint-health/', cat: 'Health', color: 'orange', title: 'Joint Health and Arthritis in Aging Pets', desc: 'Recognizing arthritis early, managing pain, and adapting your home for arthritic dogs and cats.', time: '~10 min', img: 'https://images.unsplash.com/photo-1596492784531-6e6eb5ea9993?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/best-senior-dog-food/', cat: 'Dogs', color: 'amber', title: 'Best Senior Dog Food Guide: What to Feed Your Aging Dog', desc: 'A guide to body and muscle condition, nutritional adequacy, medical needs, and individualized veterinary guidance when reviewing food for a senior dog.', time: '~14 min', img: 'https://images.unsplash.com/photo-1589941013453-ec89f33b5e95?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/dog-aging-signs/', cat: 'Dogs', color: 'amber', title: '7 Signs Your Dog Is Aging: What Every Owner Should Know', desc: 'Is your dog slowing down, sleeping more, or acting different? Discover 7 key signs of aging in dogs — from joint stiffness to cognitive decline — and how to help.', time: '~10 min', img: 'https://images.unsplash.com/photo-1517423440428-a5a00ad493e8?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/dog-human-years/', cat: 'Dogs', color: 'amber', title: 'How Old Is My 10-Year-Old Dog in Human Years? (Full Age Chart)', desc: "A 10-year-old dog isn't simply 70 in human years. Explore the site’s educational age comparison, size context and model limitations.", time: '~8 min', img: 'https://images.unsplash.com/photo-1537151641189-e685b57b5d1c?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/how-long-do-cats-live/', cat: 'Cats', color: 'purple', title: 'How Long Do Cats Live? Lifespan Context', desc: 'Population lifespan context and the limits of general ranges; no individual forecast.', time: '~15 min', img: 'https://images.unsplash.com/photo-1574158622682-e40e69881006?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/pet-aging-guide/', cat: 'Comprehensive Guide', color: 'blue', title: 'The Complete Pet Aging Guide: Everything You Need to Know', desc: "A comprehensive guide to pet aging — educational dog and cat age comparisons, what signs to watch for, how nutrition changes, and what senior care actually looks like.", time: '~15 min', img: 'https://images.unsplash.com/photo-1425082661705-1834bfd09dca?w=600&h=400&fit=crop&fm=webp' },
  { href: '/en/blog/senior-dog-care-checklist/', cat: 'Dogs', color: 'amber', title: 'Senior Dog Care Checklist: Everything Your Aging Dog Needs', desc: 'A complete senior dog care checklist covering vet visits, nutrition, exercise, joint health, dental care, and home adjustments — everything you need to keep your older dog comfortable and healthy.', time: '~12 min', img: 'https://images.unsplash.com/photo-1518717758536-85ae29035b6d?w=600&h=400&fit=crop&fm=webp' },
    { href: '/en/blog/how-long-do-dogs-live/', cat: 'Dogs', color: 'amber', title: 'How Long Do Dogs Live? Average Lifespan by Breed, Size & More', desc: 'Explore population context for dog longevity, the limits of size and breed references, and individualized care discussions without predicting a dog’s lifespan.', time: '~15 min', img: 'https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=600&h=400&fit=crop&fm=webp' },
];
---

<BaseLayout
  title="Senior Pet Care Blog - Dog and Cat Aging Guides - Pet Aging Hub"
  description="Expert guides on senior pet care, aging signs, nutrition, exercise, and health. Practical advice for dog and cat owners."
  lang="en"
  breadcrumbs={breadcrumbs}
  hrefLangAlternates={hrefLangAlternates}>

<div class="max-w-5xl mx-auto py-10 px-4">
  <header class="mb-10">
    <h1 class="text-3xl font-extrabold text-slate-900 mb-3">Pet Aging Blog</h1>
    <p class="text-slate-600 text-lg">Practical guides on caring for senior dogs and cats — nutrition, exercise, health changes, and more.</p>
  </header>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    {articles.map((a) => (
      <a href={a.href} class="group block">
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl transition-all duration-300 hover:border-amber-300 h-full flex flex-col">
          <div class="aspect-video overflow-hidden bg-slate-100">
            <img src={a.img} alt={a.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-center gap-2 mb-3">
              <span class={catBadge(a.color)}>{a.cat}</span>
              <span class="text-xs text-slate-400">{a.time}</span>
            </div>
            <h2 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">{a.title}</h2>
            <p class="text-sm text-slate-600 mt-auto">{a.desc}</p>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>
</BaseLayout>
