---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { dogSizeBands, getDogSizeLabel, getDogSeniorAge, lifespanRanges } from '../../../utils/agingModel';

const title = "Dog Age Calculator: Dog Years to Human Years by Size";
const description = "Use this dog age calculator to estimate dog years in human years with a transparent, size-aware educational model.";
const canonicalPath = "/en/tools/dog-age-calculator";
const siteUrl = "https://www.petaginghub.com";

const breadcrumbs = [
  { label: 'Tools', url: '/en/tools' },
  { label: 'Dog Age Calculator', url: canonicalPath }
];

const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/tools/dog-age-calculator/' },
  { lang: 'en', url: siteUrl + '/en/tools/dog-age-calculator/' },
  { lang: 'x-default', url: siteUrl + '/tools/dog-age-calculator/' },
];

const dogStageRows = dogSizeBands.map(({ size }) => ({ label: getDogSizeLabel(size, 'en'), range: lifespanRanges.dog[size].join('–'), senior: Math.round(getDogSeniorAge(size)) }));
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} lang="en" hrefLangAlternates={hrefLangAlternates}>

  <header class="max-w-4xl mx-auto px-6 pt-10 pb-8">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-4xl">🐶</span>
      <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">Educational estimate</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">Dog Age Calculator</h1>
    <p class="text-lg text-slate-600 leading-relaxed max-w-2xl">
      Use this dog age calculator to estimate dog years in human years with a size-aware educational model. Individual dogs age differently, so use it as a general life-stage reference.
    </p>
  </header>

  <section class="max-w-4xl mx-auto px-6 mb-10">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
      <div class="max-w-sm mx-auto text-center">
        <div class="mb-6">
          <label for="dogAge" class="block text-sm font-semibold text-slate-700 mb-2">Dog's Age (years)</label>
          <input type="number" id="dogAge" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-center text-lg" value="3" min="0" max="30" step="0.01" />
        </div>
        <div class="mb-6">
          <label for="dogSize" class="block text-sm font-semibold text-slate-700 mb-2">Adult size</label>
          <select id="dogSize" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-center">
            {dogSizeBands.map(({ size }) => <option value={size}>{getDogSizeLabel(size, 'en')}</option>)}
          </select>
        </div>
        <div class="bg-gradient-to-b from-blue-50 to-slate-50 rounded-xl p-6 mb-4">
          <p class="text-sm text-slate-500 mb-2">Equivalent human age</p>
          <p class="text-5xl font-black text-blue-600 mb-2" id="result">29 yrs</p>
          <p class="text-sm text-slate-500" id="lifeStageText">Currently: Adult</p>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-4 relative overflow-hidden border border-slate-200">
          <div id="progressFill" class="h-full transition-all duration-700 bg-blue-600 rounded-full" style="width: 30%"></div>
          <div class="absolute inset-0 flex justify-between px-2 text-[9px] text-slate-400 font-medium items-center uppercase tracking-wider">
            <span>Puppy</span><span>Adult</span><span>Senior</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 flex items-start gap-4">
      <div class="text-blue-600 mt-0.5">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-slate-800">A size-aware educational model</p>
        <p class="text-sm text-slate-500 mt-0.5">Veterinary life-stage guidance informs this page. The conversion is Pet Aging Hub’s simplified estimate, not an official AVMA formula or a clinical assessment.</p>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">How Does the Dog Age Calculator Work?</h2>
    <p class="text-slate-600">The old "1 dog year = 7 human years" rule is too simple. In this site's educational model, the first two years and later yearly increments depend on size; the human-age equivalent is not a clinical measure.</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Conversion Formula</h2>
    <div class="bg-white border border-slate-200 rounded-xl p-6 space-y-4">
      <div class="bg-slate-50 rounded-lg p-4 font-mono text-sm text-slate-600">
        <p>Small: year 1 = 15; year 2 = 24; then +4/year</p><p>Medium: year 1 = 15; year 2 = 24; then +5/year</p><p>Large: year 1 = 15; year 2 = 24; then +6/year</p><p>Giant: year 1 = 12; year 2 = 22; then +7/year</p>
      </div>
      <p class="text-slate-600">Breed, genetics, health, weight, and lifestyle can change how an individual dog ages. See our <a href="/en/blog/dog-aging-by-breed/" class="text-blue-600 underline">dog aging by breed and size guide</a> for context.</p>
      <p class="text-xs text-slate-500">Methodology note: veterinary life-stage guidance is used as context; Pet Aging Hub defines the conversion model above. It is not an official AVMA conversion formula.</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Dog Life Stage Reference by Size</h2>
    <div class="grid gap-4">
      {dogStageRows.map((row) => (
        <div class="bg-white border border-slate-200 rounded-xl p-5">
          <strong class="text-slate-800">{row.label}</strong>
          <p class="text-slate-600">Site lifespan reference: {row.range} years; senior transition at approximately {row.senior} years (75% of the range midpoint).</p>
        </div>
      ))}
    </div>
    <p class="text-xs text-slate-500 mt-3">These lifespan ranges and weight bands are Pet Aging Hub approximations, not AAHA-defined cutoffs. AAHA describes senior as approximately the final 25% of an individual dog's expected life.</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">Does breed size affect when a dog becomes a senior?</summary>
        <div class="px-5 pb-5 text-slate-600">Yes. Smaller dogs often reach senior life stages later than larger dogs, while giant breeds may do so earlier. This calculator is a size-aware educational reference, not a clinical assessment.</div>
      </details>
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">At what age does the senior life stage begin?</summary>
        <div class="px-5 pb-5 text-slate-600">The senior stage varies with size, breed, health, and lifestyle. A veterinarian can recommend an appropriate preventive-care schedule for an individual dog.</div>
      </details>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Related Calculators & Articles</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <a href="/en/tools/cat-age-calculator/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-2"><span class="text-2xl">🐱</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">Cat Age Calculator</span></div>
        <p class="text-sm text-slate-500">Estimate your cat's human-equivalent age with a transparent educational model.</p>
      </a>
      <a href="/en/blog/senior-pet-health-guide/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-2 mb-2"><span class="text-lg">🏥</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">Senior Pet Health Guide</span></div>
        <p class="text-sm text-slate-500">Everything you need to know about caring for aging pets.</p>
      </a>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="border-t border-slate-200 pt-8">
      <p class="text-xs text-slate-500 leading-relaxed"><strong>Disclaimer:</strong> This calculator provides a general educational estimate, not veterinary advice, diagnosis, or treatment. Your dog’s breed, health, body condition, and lifestyle can affect aging.</p>
    </div>
  </section>

  <nav class="max-w-4xl mx-auto px-6 pb-12 flex justify-between items-center text-sm">
    <a href="/en/tools/cat-age-calculator/" class="text-blue-600 hover:text-blue-700 font-medium">← Cat Age Calculator</a>
    <a href="/en/tools/" class="text-blue-600 hover:text-blue-700 font-medium">All Tools →</a>
  </nav>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebApplication","name":"Dog Age Calculator","description":"Estimate a dog’s human-equivalent age with a transparent, size-aware educational model.","url":siteUrl + canonicalPath,"applicationCategory":"UtilitiesApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}})} />

  <script>
    import { estimateDogHumanAge, getDogLifeStage } from '../../../utils/agingModel';
    const ageInput = document.getElementById('dogAge') as HTMLInputElement;
    const sizeInput = document.getElementById('dogSize') as HTMLSelectElement;
    const resultDisplay = document.getElementById('result'); const lifeStageText = document.getElementById('lifeStageText'); const progressFill = document.getElementById('progressFill');
    const update = () => {
      const age = Number.parseFloat(ageInput.value) || 0;
      const size = sizeInput.value as 'small' | 'medium' | 'large' | 'giant';
      const humanAge = estimateDogHumanAge(age, size);
      const lifeStage = getDogLifeStage(age, size);
      const stage = lifeStage === 'senior' ? 'Senior' : lifeStage === 'puppy' ? 'Puppy / adolescent' : 'Adult';
      if (resultDisplay) resultDisplay.textContent = humanAge + ' yrs';
      if (lifeStageText) lifeStageText.textContent = 'Estimated stage: ' + stage;
      if (progressFill) progressFill.style.width = Math.min(100, Math.max(5, age * 8)) + '%';
    };
    ageInput.addEventListener('input', update); sizeInput.addEventListener('change', update); update();
  </script>
</BaseLayout>
