---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DogAgeCalculator from '../../../components/DogAgeCalculator.astro';
const title = "Dog Age Calculator: Estimate Human Years by Size";
const description = "Enter your dog's age and adult size for an educational human-age estimate and general age-stage reference. Supports decimals, with a chart and transparent methodology.";
const breadcrumbs = [
  { label: 'Tools', url: '/en/tools/' },
  { label: 'Dog Age Calculator', url: '/en/tools/dog-age-calculator/' },
];
---
<BaseLayout title={title} description={description} lang="en" breadcrumbs={breadcrumbs}>
  <header class="max-w-4xl mx-auto sm:px-6 pt-10 pb-6">
    <span class="inline-block text-sm font-medium text-blue-700 bg-blue-50 px-3 py-1 rounded-full mb-3">Educational estimate</span>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">Dog Age Calculator</h1>
    <p class="text-lg text-slate-600 leading-relaxed">Enter your dog's age and adult size to estimate human-equivalent years and get Pet Aging Hub’s simplified age-stage reference.</p>
  </header>
  <DogAgeCalculator lang="en" />
</BaseLayout>
