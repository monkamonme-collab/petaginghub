---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { dogSizeBands, getDogSizeLabel, lifespanRanges } from '../../../utils/agingModel';

const breadcrumbs = [
  { label: 'Home', url: '/en/tools/' },
  { label: 'Lifespan Calculator', url: '/en/tools/lifespan-calculator/' }
];

const siteUrl = "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/tools/lifespan-calculator' },
  { lang: 'en', url: siteUrl + '/en/tools/lifespan-calculator' },
  { lang: 'x-default', url: siteUrl + '/tools/lifespan-calculator' },
];
---

<BaseLayout
  title="Pet Lifespan Calculator - Dog & Cat Life Expectancy - Pet Aging Hub"
  description="Explore an educational dog or cat lifespan range by species and size or living context. It is not an individual prediction or medical assessment."
  lang="en"
  breadcrumbs={breadcrumbs}
  hrefLangAlternates={hrefLangAlternates}>

  <div class="max-w-3xl mx-auto py-8 px-4">
    <header class="mb-8 text-center">
      <h1 class="text-3xl font-extrabold text-slate-900 mb-3">🕐 Pet Lifespan Calculator</h1>
      <p class="text-slate-600 text-lg">Explore a contextual lifespan range for your dog or cat. It is not a prediction or medical assessment.</p>
    </header>

    <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6 shadow-sm">
      <div class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Species</label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="species" value="dog" id="speciesDog" class="accent-amber-500" checked />
              <span class="font-medium">🐶 Dog</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="species" value="cat" id="speciesCat" class="accent-purple-500" />
              <span class="font-medium">🐱 Cat</span>
            </label>
          </div>
        </div>

        <div id="dogOptions">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Dog Size / Breed</label>
          <select id="dogSizeSelect" class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-amber-400">
            {dogSizeBands.map(({ size }) => <option value={size} selected={size === 'medium'}>{getDogSizeLabel(size, 'en')} — site reference: {lifespanRanges.dog[size].join('–')} yrs</option>)}
          </select>
        </div>

        <div id="catOptions" class="hidden">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Cat Type</label>
          <select id="catTypeSelect" class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-400">
            <option value="indoor" selected>Indoor cat — site reference: {lifespanRanges.cat.indoor.join('–')} yrs</option>
            <option value="outdoor">Outdoor / free-roaming — site reference: {lifespanRanges.cat.outdoor.join('–')} yrs</option>
            <option value="indoor_outdoor">Indoor-outdoor — site reference: {lifespanRanges.cat.indoor_outdoor.join('–')} yrs</option>
            <option value="large_breed">Large breed — site reference: {lifespanRanges.cat.large_breed.join('–')} yrs</option>
          </select>
          <p class="text-sm text-slate-600 mt-2">These are site assumptions, not official population statistics or an individual forecast. Lifestyle and breed categories can overlap. For an educational age comparison, use the <a href="/en/tools/cat-age-calculator/" class="text-blue-700 underline">Cat Age Calculator</a>; for background, read <a href="/en/blog/how-long-do-cats-live/" class="text-blue-700 underline">how long cats live</a>.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Current Age (years)</label>
          <input type="number" id="currentAge" min="0" max="30" step="0.01" placeholder="e.g. 5"
            class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-slate-400" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Lifestyle Factors (optional)</label>
          <div class="space-y-2">
            <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition">
              <input type="checkbox" id="neutered" class="accent-green-500 w-4 h-4" />
              <div>
                <span class="font-medium text-slate-800">Spayed / Neutered</span>
                <p class="text-xs text-slate-500">A health-history detail to discuss with your veterinary team.</p>
              </div>
            </label>
            <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition">
              <input type="checkbox" id="regularVet" class="accent-green-500 w-4 h-4" />
              <div>
                <span class="font-medium text-slate-800">Regular Vet Checkups</span>
                <p class="text-xs text-slate-500">A useful part of an individual preventive-care plan.</p>
              </div>
            </label>
            <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition">
              <input type="checkbox" id="overweight" class="accent-red-500 w-4 h-4" />
              <div>
                <span class="font-medium text-slate-800">Overweight / Obese</span>
                <p class="text-xs text-slate-500">A body-condition concern worth discussing with a veterinarian.</p>
              </div>
            </label>
          </div>
        </div>

        <button id="calcBtn"
          class="w-full py-4 bg-slate-900 hover:bg-slate-700 text-white font-bold rounded-xl text-lg transition-colors shadow-md">
          Calculate Lifespan Estimate
        </button>
      </div>
    </div>

    <div id="results" class="hidden bg-gradient-to-br from-slate-50 to-blue-50 rounded-2xl p-6 border border-slate-200 mb-8">
      <h2 class="text-xl font-bold text-slate-900 mb-4">📊 Your Estimate</h2>
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100">
          <div class="text-3xl font-extrabold text-blue-600" id="lifespanRange">—</div>
          <div id="range-label" class="text-sm text-slate-600 mt-1">Estimated lifespan</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100">
          <div class="text-3xl font-extrabold text-emerald-600" id="yearsRemaining">—</div>
          <div class="text-sm text-slate-600 mt-1">Range midpoint minus current age</div>
        </div>
      </div>
      <div id="lifestageInfo" class="bg-white rounded-xl p-4 border border-slate-100 mb-4">
        <p class="font-semibold text-slate-900 mb-1" id="lifestageLabel"></p>
        <p class="text-sm text-slate-600" id="lifestageAdvice"></p>
      </div>
      <div id="factorNotes" class="text-sm text-slate-600 space-y-1"></div>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 mb-8">
      <p class="text-sm text-slate-700 leading-relaxed">
        <strong>⚠️ Important:</strong> These ranges and weight bands are Pet Aging Hub educational approximations, not AAHA-defined categories or predictions for an individual pet. Genetics, health, and environment matter. Consult your veterinarian for personalized guidance.
      </p>
    </div>

    <div class="bg-white rounded-2xl p-6 border border-slate-200 mb-6">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Site Lifespan Reference Ranges</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 pr-4 font-semibold text-slate-700">Category</th>
              <th class="text-left py-2 pr-4 font-semibold text-slate-700">Reference Range</th>
              <th class="text-left py-2 font-semibold text-slate-700">Examples</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {dogSizeBands.map(({ size }) => <tr><td class="py-2 pr-4 text-slate-700">🐶 {getDogSizeLabel(size, 'en')}</td><td class="py-2 pr-4 font-medium">{lifespanRanges.dog[size].join('–')} years</td><td class="py-2 text-slate-500">Size-based educational reference</td></tr>)}
            {(['indoor', 'outdoor', 'large_breed'] as const).map(key => <tr><td class="py-2 pr-4 text-slate-700">🐱 {key.replaceAll('_', ' ')}</td><td class="py-2 pr-4 font-medium">{lifespanRanges.cat[key].join('–')} years</td><td class="py-2 text-slate-500">Site assumption; not an individual forecast</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 justify-center">
      <a href="/en/tools/dog-age-calculator/" class="inline-flex items-center gap-2 px-6 py-3 bg-amber-100 hover:bg-amber-200 text-amber-800 font-semibold rounded-xl transition-colors">🐶 Dog Age Calculator</a>
      <a href="/en/tools/compare-aging/" class="inline-flex items-center gap-2 px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold rounded-xl transition-colors">⚖️ Compare Dog vs Cat</a>
      <a href="/en/tools/symptom-checklist/" class="inline-flex items-center gap-2 px-6 py-3 bg-red-50 hover:bg-red-100 text-red-800 font-semibold rounded-xl transition-colors">📋 Symptom Checklist</a>
    </div>
  </div>

  <script>
    import { estimateLifespanRange, getCatLifeStage, getDogLifeStage } from '../../../utils/agingModel';

    document.querySelectorAll('input[name="species"]').forEach(r => {
      r.addEventListener('change', function() {
        document.getElementById('dogOptions').classList.toggle('hidden', this.value !== 'dog');
        document.getElementById('catOptions').classList.toggle('hidden', this.value !== 'cat');
      });
    });

    document.getElementById('calcBtn').addEventListener('click', function() {
      const species = document.querySelector('input[name="species"]:checked').value as 'dog' | 'cat';
      const currentAge = parseFloat(document.getElementById('currentAge').value);
      document.getElementById('range-label').textContent = species === 'cat' ? 'Site reference range, not an individual forecast' : 'Estimated lifespan';
      const neutered = document.getElementById('neutered').checked;
      const regularVet = document.getElementById('regularVet').checked;
      const overweight = document.getElementById('overweight').checked;

      let sizeKey = species === 'dog' ? document.getElementById('dogSizeSelect').value : document.getElementById('catTypeSelect').value;
      const notes = [];
      if (neutered) notes.push('Spayed/neutered status is one contextual factor, not a guarantee.');
      if (regularVet) notes.push('Preventive care supports discussion with a veterinary team.');
      if (overweight) notes.push('Body condition is worth discussing with a veterinarian.');
      const [lo, hi] = estimateLifespanRange(species, sizeKey as 'small' | 'medium' | 'large' | 'giant' | 'indoor' | 'outdoor' | 'indoor_outdoor' | 'large_breed');

      const midpoint = (lo + hi) / 2;
      const remaining = isNaN(currentAge) || currentAge <= 0 ? null : Math.max(0, Math.round((midpoint - currentAge) * 10) / 10);

      document.getElementById('lifespanRange').textContent = lo + '–' + hi + ' yrs';
      document.getElementById('yearsRemaining').textContent = remaining !== null ? '~' + remaining + ' yrs' : 'N/A';

      if (!isNaN(currentAge)) {
        const stage = species === 'dog'
          ? getDogLifeStage(currentAge, sizeKey as 'small' | 'medium' | 'large' | 'giant')
          : getCatLifeStage(currentAge);
        document.getElementById('lifestageLabel').textContent = 'Life Stage: ' + stage.replace(/([A-Z])/g, ' $1');
        document.getElementById('lifestageAdvice').textContent = 'A general life-stage reference, not an individual health assessment.';
        document.getElementById('lifestageInfo').classList.remove('hidden');
      } else {
        document.getElementById('lifestageInfo').classList.add('hidden');
      }

      const notesEl = document.getElementById('factorNotes');
      notesEl.innerHTML = notes.map(n => '<p>' + n + '</p>').join('');

      document.getElementById('results').classList.remove('hidden');
    });
  </script>
</BaseLayout>
