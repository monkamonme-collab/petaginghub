---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CatAgeCalculator from '../../../components/CatAgeCalculator.astro';
const title = 'Cat Age Calculator: Estimate Cat Years in Human Years';
const description = 'Enter your cat’s age for an educational human-equivalent estimate and general age-stage reference. Decimals supported; not a health or lifespan prediction.';
const breadcrumbs = [{ label: 'Tools', url: '/en/tools' }, { label: 'Cat Age Calculator', url: '/en/tools/cat-age-calculator' }];
const siteUrl = 'https://www.petaginghub.com';
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/tools/cat-age-calculator/' },
  { lang: 'en', url: siteUrl + '/en/tools/cat-age-calculator/' },
  { lang: 'x-default', url: siteUrl + '/tools/cat-age-calculator/' },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} lang="en" hrefLangAlternates={hrefLangAlternates}>
  <CatAgeCalculator lang="en" />
</BaseLayout>
