---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSenseAd from '../../../components/AdSenseAd.astro';

const title = "Cat Age Calculator: Cat Years to Human Years";
const description = "Use this cat age calculator to estimate cat years in human years with a transparent educational model and life-stage context.";
const canonicalPath = "/en/tools/cat-age-calculator";
const siteUrl = "https://www.petaginghub.com";

const breadcrumbs = [
  { label: 'Tools', url: '/en/tools' },
  { label: 'Cat Age Calculator', url: canonicalPath }
];

const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/tools/cat-age-calculator/' },
  { lang: 'en', url: siteUrl + '/en/tools/cat-age-calculator/' },
  { lang: 'x-default', url: siteUrl + '/tools/cat-age-calculator/' },
];

const lifeStages = [
  { range: 'Birth–1 yr', stage: 'Kitten', note: 'A period of rapid growth and development.' },
  { range: '1–6 yrs', stage: 'Young adult', note: 'Health, nutrition, behavior, and weight still matter.' },
  { range: '7–10 yrs', stage: 'Mature adult', note: 'Changes in mobility, appetite, or grooming are worth discussing with a veterinarian.' },
  { range: '>10 yrs', stage: 'Senior', note: 'Individual health needs can vary widely.' },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} lang="en" hrefLangAlternates={hrefLangAlternates}>
  <header class="max-w-4xl mx-auto px-6 pt-10 pb-8">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-4xl">🐱</span>
      <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">Educational estimate</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">Cat Age Calculator</h1>
    <p class="text-lg text-slate-600 leading-relaxed max-w-2xl">
      Wondering how old your cat is in human years? Use this cat age calculator for a transparent, general estimate and helpful feline life-stage context. It is not a veterinary assessment.
    </p>
  </header>

  <section class="max-w-4xl mx-auto px-6 mb-10">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
      <div class="max-w-sm mx-auto text-center">
        <div class="mb-6">
          <label class="block text-sm font-semibold text-slate-700 mb-2" for="catAge">Cat's age (years)</label>
          <input type="number" id="catAge" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-center text-lg" value="3" min="0" max="30" />
        </div>
        <div class="bg-gradient-to-b from-blue-50 to-slate-50 rounded-xl p-6 mb-4">
          <p class="text-sm text-slate-500 mb-2">Estimated human-equivalent age</p>
          <p class="text-5xl font-black text-blue-600 mb-2" id="result">28 yrs</p>
          <p class="text-sm text-slate-500" id="lifeStageText">Estimated stage: Young adult</p>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-4 relative overflow-hidden border border-slate-200">
          <div id="progressFill" class="h-full transition-all duration-700 bg-blue-600 rounded-full" style="width: 24%"></div>
          <div class="absolute inset-0 flex justify-between px-2 text-[9px] text-slate-400 font-medium items-center uppercase tracking-wider">
            <span>Kitten</span><span>Adult</span><span>Senior</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 flex items-start gap-4">
      <div class="text-blue-600 mt-0.5">ⓘ</div>
      <div>
        <p class="text-sm font-semibold text-slate-800">A transparent educational model</p>
        <p class="text-sm text-slate-500 mt-0.5">
          This calculator uses a commonly used segmented estimate: 15 human-equivalent years for the first cat year, 24 by the second, then about four per additional year. Pet Aging Hub defines this simplified model; it is not an official AAHA, AAFP, or AVMA conversion formula.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-6 mb-12"><AdSenseAd format="in-article" /></div>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">How cat years are estimated</h2>
    <div class="prose prose-slate prose-headings:text-slate-900 prose-p:text-slate-600 max-w-none space-y-4">
      <p>Cats mature quickly during their first two years, then their rate of aging changes. That is why a simple “one cat year equals seven human years” rule is not a reliable way to describe every stage of a cat’s life.</p>
      <p>The estimate is a useful conversation starter, not a prediction of health, lifespan, or biological age. Breed, body condition, lifestyle, genetics, and medical history all make a difference for an individual cat.</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Cat years to human years: the model</h2>
    <div class="bg-white border border-slate-200 rounded-xl p-6 space-y-4">
      <div class="bg-slate-50 rounded-lg p-4 font-mono text-sm text-slate-600">
        <p>Year 1 → 15 human-equivalent years</p>
        <p>Year 2 → 24 human-equivalent years</p>
        <p>Year 3 onward → add about 4 years per cat year</p>
      </div>
      <p class="text-slate-600">Examples: a 5-year-old cat estimates to about 36 human-equivalent years; a 10-year-old cat estimates to about 56. These are rounded educational references, not clinical facts.</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Feline life-stage context</h2>
    <p class="text-slate-600 mb-4">The 2021 AAHA/AAFP Feline Life Stage Guidelines describe kitten, young adult, mature adult, and senior age-related stages. These groupings support individualized care; they are not a human-age conversion chart.</p>
    <div class="grid gap-4">
      {lifeStages.map((stage) => (
        <div class="bg-white border border-slate-200 rounded-xl p-5">
          <span class="inline-block text-xs font-bold px-2 py-0.5 rounded mb-2 bg-blue-100 text-blue-700">{stage.range}</span>
          <h3 class="font-semibold text-slate-800">{stage.stage}</h3>
          <p class="text-slate-600 mt-1">{stage.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Frequently asked questions</h2>
    <div class="space-y-4">
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">How old is a 20-year-old cat in human years?</summary>
        <div class="px-5 pb-5 text-slate-600">Using this estimator, a 20-year-old cat is about 96 human-equivalent years. It is a mathematical estimate only; it does not describe a cat’s health or quality of life.</div>
      </details>
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">When is a cat considered senior?</summary>
        <div class="px-5 pb-5 text-slate-600">The 2021 AAHA/AAFP life-stage guidance describes cats over 10 years as senior. Age groups are general reference points, and individual cats can have different needs.</div>
      </details>
      <details class="bg-white border border-slate-200 rounded-xl group">
        <summary class="p-5 cursor-pointer font-semibold text-slate-800 hover:text-blue-600 transition-colors">Should I change my cat's food because of age?</summary>
        <div class="px-5 pb-5 text-slate-600">Food choices should reflect an individual cat’s health, weight, appetite, and veterinary advice. Do not change a therapeutic diet solely because of an online age estimate.</div>
      </details>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Related tools and reading</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <a href="/en/blog/cat-aging-by-weight/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-2"><span class="text-2xl">📖</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">Cat aging by weight</span></div>
        <p class="text-sm text-slate-500">Explore how weight, lifestyle, and individual factors can affect aging context.</p>
      </a>
      <a href="/en/blog/senior-cat-care/" class="bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-md transition-all group">
        <div class="flex items-center gap-3 mb-2"><span class="text-2xl">🐾</span><span class="font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">Senior cat care guide</span></div>
        <p class="text-sm text-slate-500">Practical, non-diagnostic guidance for supporting an older cat at home.</p>
      </a>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 mb-12">
    <div class="border-t border-slate-200 pt-8">
      <p class="text-xs text-slate-500 leading-relaxed"><strong>Disclaimer:</strong> This calculator gives a general educational estimate, not veterinary advice, diagnosis, or treatment. Your cat’s health and aging can differ from any chart. Consult a licensed veterinarian about changes in behavior, appetite, mobility, hydration, or health.</p>
    </div>
  </section>

  <nav class="max-w-4xl mx-auto px-6 pb-12 flex justify-between items-center text-sm">
    <a href="/en/tools/dog-age-calculator/" class="text-blue-600 hover:text-blue-700 font-medium">← Dog Age Calculator</a>
    <a href="/en/tools/" class="text-blue-600 hover:text-blue-700 font-medium">All Tools →</a>
  </nav>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"WebApplication",
    "name":"Cat Age Calculator",
    "description":"Estimate a cat’s human-equivalent age with a transparent educational model and feline life-stage context.",
    "url":siteUrl + canonicalPath,
    "applicationCategory":"UtilitiesApplication",
    "operatingSystem":"All",
    "offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},
    "inLanguage":"en"
  })} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"FAQPage",
    "mainEntity":[
      {"@type":"Question","name":"How old is a 20-year-old cat in human years?","acceptedAnswer":{"@type":"Answer","text":"Using this estimator, a 20-year-old cat is about 96 human-equivalent years. It is a mathematical estimate only; it does not describe a cat’s health or quality of life."}},
      {"@type":"Question","name":"When is a cat considered senior?","acceptedAnswer":{"@type":"Answer","text":"The 2021 AAHA/AAFP life-stage guidance describes cats over 10 years as senior. Age groups are general reference points, and individual cats can have different needs."}},
      {"@type":"Question","name":"Should I change my cat's food because of age?","acceptedAnswer":{"@type":"Answer","text":"Food choices should reflect an individual cat’s health, weight, appetite, and veterinary advice. Do not change a therapeutic diet solely because of an online age estimate."}}
    ]
  })} />

  <script>
    const ageInput = document.getElementById('catAge') as HTMLInputElement;
    const resultDisplay = document.getElementById('result');
    const lifeStageText = document.getElementById('lifeStageText');
    const progressFill = document.getElementById('progressFill');

    const update = () => {
      const age = parseInt(ageInput.value) || 0;
      const humanAge = age <= 0 ? 0 : age === 1 ? 15 : age === 2 ? 24 : 24 + (age - 2) * 4;
      const stage = age <= 1 ? 'Kitten' : age <= 6 ? 'Young adult' : age <= 10 ? 'Mature adult' : 'Senior';
      if (resultDisplay) resultDisplay.textContent = humanAge + ' yrs';
      if (lifeStageText) lifeStageText.textContent = 'Estimated stage: ' + stage;
      if (progressFill) progressFill.style.width = Math.min(100, Math.max(5, age * 8)) + '%';
    };

    ageInput.addEventListener('input', update);
    update();
  </script>
</BaseLayout>
