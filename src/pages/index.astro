---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';

const featuredArticles = [
  {
    href: '/blog/senior-pet-health-guide/',
    image: 'https://images.unsplash.com/photo-1581888227599-779811939961?w=800&h=600&fit=crop&fm=webp',
    category: '旗艦文章',
    categoryColor: 'purple',
    title: '老年寵物健康完整指南',
    description: '從營養需求到環境調整，全方位解析 7 歲以上寵物的照護要點。',
    readTime: '約 15 分鐘',
    emoji: '📋'
  },
  {
    href: '/blog/dog-vs-cat-aging/',
    image: 'https://images.unsplash.com/photo-1544568100-847a948585b9?w=800&h=600&fit=crop&fm=webp',
    category: '比較分析',
    categoryColor: 'blue',
    title: '狗與貓老化差異完整比較',
    description: '9 個維度全面對比：老化速度、壽命、老年常見疾病與照護重點參照。',
    readTime: '約 10 分鐘',
    emoji: '📊'
  },
  {
    href: '/blog/dog-aging-by-breed/',
    image: 'https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=800&h=600&fit=crop&fm=webp',
    category: '狗狗',
    categoryColor: 'amber',
    title: '狗狗品種與老化速度',
    description: '從吉娃娃到大丹犬，15+ 品種的老化時間表與照護建議。',
    readTime: '約 12 分鐘',
    emoji: '🐕'
  },
  {
    href: '/blog/cat-aging-by-weight/',
    image: 'https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=800&h=600&fit=crop&fm=webp',
    category: '貓咪',
    categoryColor: 'purple',
    title: '熟齡貓體重變化與體態',
    description: '觀察體重趨勢與肌肉狀態；不以體重推算年齡或壽命。',
    readTime: '約 10 分鐘',
    emoji: '🐱'
  }
];

const tools = [
  {
    href: '/tools/dog-age-calculator/',
    emoji: '🐕',
    badge: '熱門',
    badgeColor: 'blue',
    title: '狗狗年齡計算機',
    description: '獲得人類年齡對照與生命階段建議。'
  },
  {
    href: '/tools/cat-age-calculator/',
    emoji: '🐱',
    badge: '熱門',
    badgeColor: 'purple',
    title: '貓咪年齡計算機',
    description: '獲得針對性的老齡貓照護建議。'
  },
  {
    href: '/tools/compare-aging/',
    emoji: '⚖️',
    badge: '新功能',
    badgeColor: 'teal',
    title: '年齡對照工具',
    description: '同時比較狗狗和貓咪的人類年齡。'
  }
];

const heroImage = 'https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=900&h=450&fit=crop&fm=webp';
const siteUrl = "https://www.petaginghub.com";
const hrefLangAlternates = [
  { lang: 'zh-TW', url: siteUrl + '/' },
  { lang: 'en', url: siteUrl + '/en/' },
  { lang: 'x-default', url: siteUrl + '/' },
];
---

<BaseLayout
  title="了解你的寵物：狗狗與貓咪年齡計算機與老年照護指南"
  description="簡單的工具與實用指南，幫助你了解狗狗和貓咪的老化過程、健康變化與老年照護需求。"
  lang="zh-TW"
  hrefLangAlternates={hrefLangAlternates}
  preloadHref={heroImage}>

  {/* Hero 區塊 */}
  <div class="relative bg-slate-900 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={heroImage}
        srcset="https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=480&h=240&fit=crop&fm=webp 480w,
                https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=900&h=450&fit=crop&fm=webp 900w,
                https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=1200&h=600&fit=crop&fm=webp 1200w"
        sizes="100vw"
        alt="照護與陪伴老年毛孩"
        class="w-full h-full object-cover opacity-40"
        width="900"
        height="450"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/90 to-slate-900/60"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-6 py-20 md:py-28 text-center md:text-left">
      <div class="inline-flex items-center gap-2 bg-amber-500/20 text-amber-300 text-sm font-medium px-4 py-2 rounded-full mb-6 backdrop-blur-sm border border-amber-400/30">
        <span>🐾</span>
        <span>寵物年齡與健康資源中心</span>
      </div>

      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-tight">
        了解你的寵物<br />
        年齡與健康狀況
      </h1>

      <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <a href="/tools/dog-age-calculator/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-amber-500 hover:bg-amber-600 text-white font-semibold rounded-xl transition-colors shadow-lg">
          <span class="text-xl">🐕</span> 狗狗年齡計算
        </a>
        <a href="/tools/cat-age-calculator/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl transition-colors border border-white/20">
          <span class="text-xl">🐱</span> 貓咪年齡計算
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-16">
    <section class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
          <span class="text-2xl">📚</span> 精選照護指南
        </h2>
        <a href="/blog/" class="text-amber-600 hover:text-amber-700 font-medium text-sm flex items-center gap-1">所有文章 →</a>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {featuredArticles.map((article) => (
          <a href={article.href} class="group block">
            <Card class="h-full hover:shadow-xl transition-all duration-300 hover:border-amber-300 overflow-hidden p-0">
              <div class="aspect-video overflow-hidden bg-slate-100">
                <img src={article.image} alt={article.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class={`px-2 py-1 text-xs font-bold rounded-full ${
                    article.categoryColor === 'purple' ? 'bg-purple-100 text-purple-700' :
                    article.categoryColor === 'blue' ? 'bg-blue-100 text-blue-700' :
                    'bg-amber-100 text-amber-700'
                  }`}>
                    {article.category}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">{article.title}</h3>
                <p class="text-slate-600 mb-4 line-clamp-2 text-sm">{article.description}</p>
                <span class="text-xs text-slate-500">⏱️ 閱讀時間：{article.readTime}</span>
              </div>
            </Card>
          </a>
        ))}
      </div>
    </section>

    <section class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
          <span class="text-2xl">🧮</span> 快速計算工具
        </h2>
        <a href="/tools/" class="text-amber-600 hover:text-amber-700 font-medium text-sm">更多工具 →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {tools.map((tool) => (
          <a href={tool.href} class="group block">
            <Card class="h-full hover:shadow-lg transition-all duration-300 hover:border-amber-300 text-center">
              <div class="text-4xl mb-4">{tool.emoji}</div>
              <h3 class="font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">{tool.title}</h3>
              <p class="text-sm text-slate-600">{tool.description}</p>
            </Card>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
          <span class="text-2xl">🕐</span> 最近更新
        </h2>
      </div>

      <div class="bg-gradient-to-br from-slate-50 to-amber-50 rounded-3xl p-8 border border-slate-200">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4">
              <span class="text-3xl">🏆</span>
              <div>
                <p class="text-xs text-indigo-600 font-bold mb-1">重點發布</p>
                <a href="/blog/senior-pet-health-guide/" class="text-lg font-bold text-slate-900 hover:text-amber-600 block mb-2">
                  老年寵物健康照護全攻略
                </a>
                <p class="text-sm text-slate-600">
                  深度解析熟齡犬貓的器官功能監測、精準營養與環境減壓建議。
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4">
              <span class="text-3xl">📝</span>
              <div>
                <p class="text-xs text-slate-500 mb-1">內容優化</p>
                <a href="/blog/dog-aging-by-breed/" class="text-lg font-bold text-slate-900 hover:text-amber-600 block mb-2">
                  狗狗品種與老化速度更新
                </a>
                <p class="text-sm text-slate-600">
                  新增了包含柴犬、柯基在內的多個熱門品種老化時間表。
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
