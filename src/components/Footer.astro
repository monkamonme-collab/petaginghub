---
interface Props {
  currentYear?: number;
  isEn?: boolean;
}
const { currentYear = new Date().getFullYear(), isEn = false } = Astro.props;
const p = isEn ? '/en' : '';
---

<footer class="bg-slate-900 text-slate-300 mt-20">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">

      <!-- Brand -->
      <div class="md:col-span-1">
        <a href={isEn ? '/en/' : '/'} class="flex items-center gap-2 mb-3">
          <span class="text-2xl">🐾</span>
          <span class="font-bold text-white text-lg">PetAgingHub</span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed">
          {isEn
            ? 'Educational guides and site-derived age estimates—not a veterinary assessment or lifespan prediction.'
            : '提供教育性指南與本站年齡估算，不是獸醫評估或個別壽命預測。'}
        </p>
      </div>

      <!-- 老化指南 / Aging Guides -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">
          {isEn ? 'Aging Guides' : '老化指南'}
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`${p}/blog/senior-pet-health-guide/`} class="hover:text-white transition-colors">{isEn ? 'Senior Pet Health Guide' : '老年寵物健康指南'}</a></li>
          <li><a href={`${p}/blog/dog-aging-signs/`} class="hover:text-white transition-colors">{isEn ? 'Dog Aging Signs' : '狗狗老化徵兆'}</a></li>
          <li><a href={`${p}/blog/cat-aging-signs/`} class="hover:text-white transition-colors">{isEn ? 'Cat Aging Signs' : '貓咪老化徵兆'}</a></li>
        </ul>
      </div>

      <!-- 健康資源 / Health Resources -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">
          {isEn ? 'Health Resources' : '健康資源'}
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`${p}/blog/`} class="hover:text-white transition-colors">{isEn ? 'All Articles' : '所有文章'}</a></li>
          <li><a href={`${p}/tools/`} class="hover:text-white transition-colors">{isEn ? 'All Tools' : '所有工具'}</a></li>
          <li><a href={`${p}/blog/pet-nutrition-by-age/`} class="hover:text-white transition-colors">{isEn ? 'Nutrition by Age' : '各年齡營養指南'}</a></li>
        </ul>
      </div>

      <!-- 計算工具 / Calculators -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">
          {isEn ? 'Calculators' : '計算工具'}
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`${p}/tools/dog-age-calculator/`} class="hover:text-white transition-colors">{isEn ? 'Dog Age Calculator' : '狗狗年齡計算機'}</a></li>
          <li><a href={`${p}/tools/cat-age-calculator/`} class="hover:text-white transition-colors">{isEn ? 'Cat Age Calculator' : '貓咪年齡計算機'}</a></li>
          <li><a href={`${p}/tools/lifespan-calculator/`} class="hover:text-white transition-colors">{isEn ? 'Lifespan Calculator' : '壽命計算機'}</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-slate-700 pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
      <p>© {currentYear} PetAgingHub. {isEn ? 'All rights reserved.' : '版權所有。'}</p>
      <div class="flex gap-4">
        <a href={`${p}/privacy-policy/`} class="hover:text-slate-300 transition-colors">{isEn ? 'Privacy Policy' : '隱私政策'}</a>
        <a href={`${p}/terms/`} class="hover:text-slate-300 transition-colors">{isEn ? 'Terms of Service' : '服務條款'}</a>
        <a href={`${p}/about/`} class="hover:text-slate-300 transition-colors">{isEn ? 'About Us' : '關於我們'}</a>
      </div>
      <p class="text-slate-600">
        {isEn
          ? 'Content is for informational purposes only. Consult a licensed veterinarian for medical advice.'
          : '本站內容僅供參考，不構成獸醫診斷或治療建議。如有疑慮，請諮詢執業獸醫師。'}
      </p>
    </div>
  </div>
</footer>
