---
interface Props {
  title: string;
  description: string;
  ogType?: string;
  hrefLangAlternates?: { lang: string; url: string }[];
  schemaType?: string;
}

const { title, description, ogType = 'website', hrefLangAlternates = [], schemaType } = Astro.props;
const siteUrl = "https://www.petaginghub.com";
const canonicalStr = siteUrl + Astro.url.pathname;

const resolvedSchemaType = schemaType ?? (ogType === 'article' ? 'BlogPosting' : 'WebPage');
const schemaJSON = JSON.stringify({
  "@context": "https://schema.org",
  "@type": resolvedSchemaType,
  "name": title,
  "description": description,
  "url": canonicalStr
});

// Normalize hreflang URLs: ensure trailing slash and correct domain
function normalizeHreflangUrl(url: string): string {
  // Replace old Vercel domain with production domain
  let normalized = url.replace('https://git-github-com-kenny-yan9-ad-site.vercel.app', 'https://www.petaginghub.com');
  // Ensure trailing slash (add if not present and no file extension)
  if (!normalized.endsWith('/') && !normalized.match(/\.[a-zA-Z]{2,4}$/)) {
    normalized = normalized + '/';
  }
  return normalized;
}
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalStr} />

{hrefLangAlternates.map(alt => (
  <link rel="alternate" hreflang={alt.lang} href={normalizeHreflangUrl(alt.url)} />
))}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalStr} />

<!-- Schema.org -->
<script type="application/ld+json" set:html={schemaJSON} />
